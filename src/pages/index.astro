---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<header class="glass nav-header">
		<div class="container">
			<div class="logo">
				<span class="logo-icon">A</span>
				<span>AbsenTech</span>
			</div>
			<nav>
				<a href="#features">Fitur</a>
				<a href="#about">Tentang</a>
				<a href="/login" class="btn-login">Masuk</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero">
			<div class="hero-bg" style="background-image: url('/hero-bg.png');"></div>
			<div class="hero-overlay"></div>
			<div class="container hero-content">
				<div class="badge">Sistem Absensi v2.0</div>
				<h1>Solusi Absensi <span class="gradient-text">Cerdas</span> & <span class="gradient-text">Otomatis</span></h1>
				<p>Tingkatkan produktivitas tim Anda dengan sistem absensi berbasis lokasi dan wajah yang paling aman dan efisien.</p>
				<div class="hero-actions">
					<a href="/register" class="btn primary">Mulai Sekarang</a>
					<a href="#demo" class="btn secondary">Lihat Demo</a>
				</div>
				
				<div class="hero-stats glass">
					<div class="stat">
						<span class="stat-value">10k+</span>
						<span class="stat-label">Pengguna</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-value">500+</span>
						<span class="stat-label">Perusahaan</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-value">99.9%</span>
						<span class="stat-label">Uptime</span>
					</div>
				</div>
			</div>
		</section>

		<section id="features" class="features">
			<div class="container">
				<div class="section-header">
					<h2>Kenapa Memilih Kami?</h2>
					<p>Fitur unggulan yang dirancang untuk memudahkan manajemen kehadiran.</p>
				</div>
				<div class="feature-grid">
					<div class="feature-card glass">
						<div class="feature-icon">📍</div>
						<h3>Geofencing</h3>
						<p>Pastikan karyawan melakukan absensi di lokasi yang telah ditentukan.</p>
					</div>
					<div class="feature-card glass">
						<div class="feature-icon">👤</div>
						<h3>Face Recognition</h3>
						<p>Verifikasi identitas dengan teknologi pengenalan wajah mutakhir.</p>
					</div>
					<div class="feature-card glass">
						<div class="feature-icon">📊</div>
						<h3>Real-time Report</h3>
						<p>Dapatkan laporan kehadiran secara instan dan akurat setiap saat.</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container">
			<p>&copy; 2024 AbsenTech. Built with ❤️ for efficiency.</p>
		</div>
	</footer>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Header */
	.nav-header {
		position: fixed;
		top: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		width: 90%;
		max-width: 1100px;
		z-index: 1000;
		padding: 0.75rem 0;
		border-radius: 99px;
	}

	.nav-header .container {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-weight: 800;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}

	.logo-icon {
		background: linear-gradient(135deg, var(--primary), var(--accent));
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		color: white;
		font-size: 1rem;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	nav a {
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.3s;
		color: var(--text-muted);
	}

	nav a:hover {
		color: var(--text-main);
	}

	.btn-login {
		background: var(--text-main);
		color: var(--bg-dark) !important;
		padding: 0.5rem 1.5rem;
		border-radius: 99px;
		font-weight: 600;
	}

	/* Hero */
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 5rem;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		z-index: -2;
		opacity: 0.6;
		transform: scale(1.1);
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at center, transparent, var(--bg-dark) 80%);
		z-index: -1;
	}

	.hero-content {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		z-index: 10;
	}

	.badge {
		background: rgba(99, 102, 241, 0.1);
		border: 1px solid rgba(99, 102, 241, 0.2);
		color: var(--primary);
		padding: 0.4rem 1rem;
		border-radius: 99px;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 2rem;
		animation: fadeInDown 0.8s ease-out;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		line-height: 1.1;
		margin-bottom: 1.5rem;
		max-width: 900px;
		animation: fadeInUp 1s ease-out;
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--primary), var(--accent));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	p {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 600px;
		margin-bottom: 2.5rem;
		line-height: 1.6;
		animation: fadeInUp 1.2s ease-out;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-bottom: 4rem;
		animation: fadeInUp 1.4s ease-out;
	}

	.btn {
		padding: 0.8rem 2rem;
		border-radius: 12px;
		font-weight: 600;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.btn.primary {
		background: var(--primary);
		box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
	}

	.btn.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 20px 30px -10px rgba(99, 102, 241, 0.5);
		background: var(--primary-hover);
	}

	.btn.secondary {
		border: 1px solid var(--glass-border);
		background: rgba(255, 255, 255, 0.05);
	}

	.btn.secondary:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.hero-stats {
		display: flex;
		padding: 2rem 3rem;
		gap: 3rem;
		margin-top: 2rem;
		animation: fadeInUp 1.6s ease-out;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.stat-value {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-main);
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.stat-divider {
		width: 1px;
		background: var(--glass-border);
	}

	/* Features */
	.features {
		padding: 8rem 0;
		background: linear-gradient(to bottom, var(--bg-dark), #1e293b);
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.feature-card {
		padding: 2.5rem;
		transition: all 0.3s ease;
	}

	.feature-card:hover {
		transform: translateY(-5px);
		background: rgba(30, 41, 59, 0.9);
		border-color: var(--primary);
	}

	.feature-icon {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.feature-card h3 {
		margin-bottom: 1rem;
		font-size: 1.5rem;
	}

	.feature-card p {
		font-size: 1rem;
		margin-bottom: 0;
	}

	.footer {
		padding: 4rem 0;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
		border-top: 1px solid var(--glass-border);
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes fadeInDown {
		from { opacity: 0; transform: translateY(-20px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 768px) {
		.hero-stats {
			flex-direction: column;
			gap: 1.5rem;
			padding: 1.5rem;
		}
		.stat-divider {
			width: 100%;
			height: 1px;
		}
		nav {
			display: none;
		}
	}
</style>
