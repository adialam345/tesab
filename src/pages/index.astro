---
import Layout from '../layouts/Layout.astro';
import { APP_VERSION } from '../utils/constants';
---

<Layout title="E-Absensi - Solusi Modern">
    <div class="min-h-screen flex items-center justify-center p-6 bg-slate-50 relative overflow-hidden">
        <!-- Background Accents -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-100 rounded-full blur-3xl opacity-50"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-100 rounded-full blur-3xl opacity-50"></div>

        <div class="relative w-full max-w-md bg-white rounded-[40px] shadow-2xl shadow-slate-200 border border-slate-100 p-8 sm:p-12 text-center animate-in fade-in zoom-in duration-700">
            <div class="w-20 h-20 bg-indigo-50 text-indigo-600 rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-inner ring-1 ring-indigo-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            
            <h1 class="text-3xl font-black text-slate-900 mb-3 tracking-tight">E-Absensi</h1>
            <p class="text-slate-500 text-sm font-medium leading-relaxed mb-10 px-4">Solusi 1234 absensi modern dengan verifikasi biometrik dan lokasi yang presisi bagi tenaga kerja.</p>
            
            <a href="login.html" class="flex items-center justify-center gap-3 w-full py-4.5 bg-indigo-600 text-white rounded-2xl font-black text-base transition-all hover:bg-indigo-700 hover:shadow-xl hover:shadow-indigo-200 active:scale-[0.98] group">

                Masuk ke Dashboard
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>

            <div class="mt-12 pt-10 border-t border-slate-50 space-y-5">
                <div class="flex items-center gap-4 text-left p-2 rounded-2xl transition-colors hover:bg-slate-50">
                    <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
                    </div>
                    <div class="flex flex-col">
                        <strong class="text-xs font-black text-slate-900 uppercase tracking-wider">Smart Location</strong>
                        <span class="text-[11px] text-slate-400 font-bold">Presisi koordinat dalam radius target</span>
                    </div>
                </div>
                
                <div class="flex items-center gap-4 text-left p-2 rounded-2xl transition-colors hover:bg-slate-50">
                    <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div class="flex flex-col">
                        <strong class="text-xs font-black text-slate-900 uppercase tracking-wider">Biometric Auth</strong>
                        <span class="text-[11px] text-slate-400 font-bold">Validasi wajah real-time dengan AI</span>
                    </div>
                </div>
            </div>

            <p class="mt-12 text-[10px] font-black text-slate-300 uppercase tracking-[0.2em]">&copy; 2026 AbsenTech Systems &bull; v{APP_VERSION}</p>
        </div>
    </div>
</Layout>

<script>
    import { checkForUpdates } from '../utils/otaUpdate';
    import { storage } from '../utils/storage';
    
    // 1. Jalankan pengecekan update
    checkForUpdates();

    // 2. Auto-login Check
    (async () => {
        const token = await storage.get('access_token');
        if (token) {
            console.log('Sesi ditemukan, mengalihkan ke Dashboard...');
            window.location.href = 'absensi.html';
        }
    })();
</script>
