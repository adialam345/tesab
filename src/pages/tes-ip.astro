---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek IP Proxy">
    <div class="min-h-screen bg-slate-50 py-12 px-4">
        <div class="max-w-2xl mx-auto space-y-8">
            <div class="text-center">
                <h1 class="text-3xl font-black text-slate-900 text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">Uji Deteksi IP</h1>
                <p class="text-slate-500 mt-2 font-medium">Halaman ini digunakan untuk melihat IP yang terdeteksi oleh server</p>
            </div>

            <div class="bg-white p-8 rounded-[32px] border border-slate-200 shadow-xl shadow-slate-200/50 space-y-6">
                <div class="space-y-4">
                    <button id="checkIpBtn" class="w-full py-4 bg-indigo-600 text-white rounded-2xl font-black text-sm shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition-all active:scale-95 flex items-center justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"></path></svg>
                        Cek IP Sekarang
                    </button>
                </div>

                <div id="result" class="hidden space-y-4 animate-fade-in">
                    <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 ring-1 ring-slate-200/50">
                        <span class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">IP Address Terdeteksi</span>
                        <span id="ipAddr" class="text-xl font-mono font-bold text-indigo-600 tracking-tighter break-all">...</span>
                    </div>
                    
                    <div class="p-6 bg-emerald-50 rounded-2xl border border-emerald-100 ring-1 ring-emerald-200/50">
                        <span class="block text-[10px] font-black text-emerald-400 uppercase tracking-widest mb-2">Informasi Routing</span>
                        <span id="ipLoc" class="text-sm font-bold text-emerald-700 leading-relaxed block">...</span>
                    </div>

                    <div id="proxyWarning" class="p-5 bg-amber-50 rounded-2xl border border-amber-100">
                        <div class="flex gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <p class="text-xs text-amber-700 leading-relaxed font-medium">
                                <strong>Info:</strong> IP di atas adalah IP yang dilihat oleh server tujuan. Jika Proxy aktif, ini adalah IP Cloudflare, bukan IP asli pemakai.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a href="absensi.html" class="inline-flex items-center gap-2 text-sm font-black text-slate-400 hover:text-indigo-600 transition-all uppercase tracking-widest group">

                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    Kembali ke Absensi
                </a>
            </div>
        </div>
    </div>
</Layout>

<script>
    const btn = document.getElementById('checkIpBtn');
    const resultDiv = document.getElementById('result');
    const ipAddr = document.getElementById('ipAddr');
    const ipLoc = document.getElementById('ipLoc');
    const warning = document.getElementById('proxyWarning');

    btn?.addEventListener('click', async () => {
        const originalText = btn.innerHTML;
        btn.textContent = 'Mengecek...';
        btn.classList.add('opacity-50', 'pointer-events-none');

        try {
            // 1. Cek IP dari Sisi Client (IP HP User Asli)
            const clientRes = await fetch('https://api.ipify.org?format=json');
            const clientData = await clientRes.json();
            
            if (resultDiv) resultDiv.classList.remove('hidden');
            
            // Tampilkan IP HP User (Yang akan terdeteksi saat Absen)
            if (ipAddr) {
                ipAddr.innerHTML = `
                    <div class="space-y-2">
                        <div class="p-2 bg-indigo-50 rounded-lg border border-indigo-200">
                            <span class="text-[10px] text-indigo-400 block uppercase mb-1">IP HP ANDA (LANGSUNG)</span>
                            <span class="text-indigo-600 font-black">${clientData.ip}</span>
                        </div>
                    </div>
                `;
            }


            if (ipLoc) ipLoc.textContent = 'Proses absensi sekarang menggunakan jalur "IP HP ANDA" di atas.';
            if (warning) warning.classList.add('hidden');
            
        } catch (error) {
            alert('Gagal mengecek IP. Pastikan koneksi internet aktif.');
        } finally {
            btn.innerHTML = originalText;
            btn.classList.remove('opacity-50', 'pointer-events-none');
        }
    });

</script>
