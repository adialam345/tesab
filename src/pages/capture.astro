---
import Layout from '../layouts/Layout.astro';
import { TARGET_BASE_URL, APP_VERSION } from '../utils/constants';
---

<Layout title="Device ID Capture - AbsenTech">
    <main class="min-h-screen bg-slate-950 text-white p-6 flex flex-col items-center justify-center relative overflow-hidden">
        <!-- Background Glows -->
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-indigo-600/10 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-emerald-600/10 rounded-full blur-[120px]"></div>

        <div class="w-full max-w-md z-10 space-y-8 animate-in fade-in slide-in-from-bottom-10 duration-1000">
            <!-- Header -->
            <div class="text-center">
                <div class="inline-flex p-4 bg-indigo-500/10 rounded-3xl border border-indigo-500/20 mb-6 group hover:scale-110 transition-transform duration-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    </svg>
                </div>
                <h1 class="text-3xl font-black tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">ID Capture Tool</h1>
                <p class="text-slate-500 text-sm mt-2 font-medium">Solusi Capture Perangkat Mobile Paling Pasti</p>
            </div>

            <div class="bg-white/5 backdrop-blur-3xl border border-white/10 rounded-[2.5rem] p-8 space-y-6 shadow-2xl">
                <!-- Step 1: NIP Verification -->
                <div class="space-y-3">
                    <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] ml-1">LANGKAH 1: IDENTITAS</label>
                    <div class="relative">
                        <input type="text" id="nipInput" placeholder="Masukkan NIP Anda" class="w-full px-6 py-4.5 bg-white/5 border border-white/10 rounded-2xl text-white font-bold placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 transition-all text-center text-lg">
                    </div>
                </div>

                <!-- Step 2: Open Source -->
                <div class="space-y-3">
                    <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] ml-1">LANGKAH 2: SUMBER DATA</label>
                    <p class="text-[11px] text-slate-400 leading-relaxed px-1">Klik tombol di bawah untuk membuka data Anda di Chrome. Pastikan sudah login di web resmi.</p>
                    <button id="openSourceBtn" class="w-full py-4.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl font-black text-sm shadow-xl shadow-indigo-600/20 transition-all active:scale-95 flex items-center justify-center gap-3">
                        BUKA DATA DI CHROME ↗
                    </button>
                </div>

                <!-- Step 3: Paste JSON -->
                <div class="space-y-3">
                    <label class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] ml-1">LANGKAH 3: TEMPEL DATA</label>
                    <div class="relative group">
                        <textarea id="jsonInput" placeholder="Tempel semua teks dari Chrome ke sini..." class="w-full h-32 px-5 py-4 bg-white/5 border border-white/10 rounded-2xl text-emerald-400 font-mono text-[10px] placeholder:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition-all resize-none"></textarea>
                        <div class="absolute right-4 bottom-4 opacity-0 group-focus-within:opacity-100 transition-opacity">
                            <span class="text-[9px] font-black text-emerald-500 uppercase">Ready to Sync</span>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Submit -->
                <button id="submitBtn" class="w-full py-5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-2xl font-black text-sm shadow-xl shadow-emerald-600/20 transition-all active:scale-95 flex items-center justify-center gap-3">
                    KIRIM KE CLOUD & SELESAI
                </button>
            </div>

            <!-- Warning/Info -->
            <div class="flex items-center gap-4 p-5 bg-amber-500/5 border border-amber-500/10 rounded-2xl">
                <div class="w-10 h-10 bg-amber-500/10 text-amber-500 rounded-xl flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
                <p class="text-[10px] text-amber-200/60 font-medium leading-relaxed">
                    Data yang dikirim akan otomatis terdeteksi oleh aplikasi utama. Setelah klik "Kirim", Anda bisa langsung membuka kembali Aplikasi AbsenTech.
                </p>
            </div>

            <p class="text-center text-slate-800 text-[10px] font-bold uppercase tracking-[0.4em]">AbsenTech Sync Tool v{APP_VERSION}</p>
        </div>
    </main>

    <script define:vars={{ TARGET_BASE_URL }}>
        const openSourceBtn = document.getElementById('openSourceBtn');
        const submitBtn = document.getElementById('submitBtn');
        const nipInput = document.getElementById('nipInput');
        const jsonInput = document.getElementById('jsonInput');

        openSourceBtn?.addEventListener('click', () => {
            const url = `${TARGET_BASE_URL}/api/v1/auth/test-token`;
            window.open(url, '_blank');
        });

        submitBtn?.addEventListener('click', async () => {
            const nip = nipInput.value.trim();
            const raw = jsonInput.value.trim();

            if (!nip) return alert('Silakan isi NIP Anda.');
            if (!raw) return alert('Silakan tempel data dari Chrome.');

            try {
                const data = JSON.parse(raw);
                const deviceId = data.fixed_device_id || data.device_id;
                const name = data.full_name || 'Pegawai';

                if (!deviceId) {
                    alert('GAGAL: Device ID tidak ditemukan. Pastikan Anda sudah login di Chrome dan menyalin TEKS dari halaman data.');
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<div class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div> MENGIRIM...';

                // Langsung fetch ke Supabase
                const res = await fetch('https://aiyslkzvbzznfavpllwo.supabase.co/rest/v1/user_sessions?on_conflict=nip', {
                    method: 'POST',
                    headers: {
                        'apikey': 'sb_publishable_pQS5NZWik_abrK6jOqPDgw_4OHRbQWH',
                        'Authorization': 'Bearer sb_publishable_pQS5NZWik_abrK6jOqPDgw_4OHRbQWH',
                        'Content-Type': 'application/json',
                        'Prefer': 'resolution=merge-duplicates'
                    },
                    body: JSON.stringify({
                        nip: nip,
                        device_id: deviceId,
                        token: '',
                        full_name: name,
                        updated_at: new Date().toISOString()
                    })
                });

                if (res.ok) {
                    alert('🎯 BERHASIL!\nData telah terkirim.\n\nSilakan tutup Chrome dan buka kembali Aplikasi AbsenTech.');
                    location.reload();
                } else {
                    alert('Gagal mengirim data. Kode: ' + res.status);
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'KIRIM KE CLOUD & SELESAI';
                }
            } catch (e) {
                alert('Format data salah. Pastikan Anda menyalin SEMUA teks yang muncul di Chrome.');
            }
        });
    </script>
</Layout>
