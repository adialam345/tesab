---
import Layout from '../layouts/Layout.astro';
import { APP_VERSION } from '../utils/constants';
---

<Layout title="Masuk - AbsenTech">
    <div class="min-h-screen flex items-center justify-center p-6 bg-[#f8fafc] overflow-hidden relative">
        <!-- Background Elements -->
        <div class="absolute top-0 left-0 w-full h-full pointer-events-none opacity-40">
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-200 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-violet-200 rounded-full blur-3xl"></div>
        </div>

        <div class="w-full max-w-md relative">
            <div class="bg-white rounded-[2.5rem] shadow-2xl shadow-indigo-100 border border-white p-8 sm:p-10 animate-in fade-in slide-in-from-bottom-8 duration-700">
                <!-- App Identity -->
                <div class="text-center mb-10">
                    <div class="w-20 h-20 bg-gradient-to-tr from-indigo-600 to-violet-600 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-lg shadow-indigo-200 rotate-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <h1 class="text-3xl font-black text-slate-900 mb-2 tracking-tight">AbsenTech</h1>
                    <p class="text-slate-500 text-sm font-medium">Sistem Presensi Labuhanbatu Selatan</p>
                </div>

                <!-- Primary Login Form -->
                <form id="loginForm" class="space-y-5">
                    <div class="space-y-2">
                        <label for="username" class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">NIP / Username</label>
                        <div class="relative group">
                            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </div>
                            <input type="text" id="username" name="username" placeholder="Masukkan NIP" class="w-full pl-12 pr-4 py-4.5 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 text-base font-bold placeholder:text-slate-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-600 transition-all" required />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="password" class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Password</label>
                        <div class="relative group">
                            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </div>
                            <input type="password" id="password" name="password" placeholder="Masukkan password" class="w-full pl-12 pr-4 py-4.5 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 text-base font-bold placeholder:text-slate-300 focus:outline-none focus:ring-4 focus:ring-indigo-100 focus:border-indigo-600 transition-all" required />
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full py-5 bg-indigo-600 text-white rounded-2xl font-black text-lg shadow-xl shadow-indigo-100 transition-all hover:bg-indigo-700 active:scale-[0.97] flex items-center justify-center gap-3">
                        <span class="btn-text">Masuk</span>
                        <div class="loader hidden w-6 h-6 border-3 border-white/30 border-t-white rounded-full animate-spin"></div>
                    </button>

                    <div id="errorMessage" class="hidden p-4 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 text-[11px] font-black uppercase tracking-wider text-center"></div>
                </form>

                <!-- Smart Actions Section -->
                <div class="mt-8 pt-8 border-t border-slate-100 space-y-4">
                    <p class="text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4">Masalah Login atau Perangkat?</p>
                    
                    <!-- Primary Recovery Tool -->
                    <button id="chromeCaptureBtn" class="w-full py-4 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-2xl font-black text-xs shadow-sm transition-all hover:bg-emerald-100 active:scale-95 flex items-center justify-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="21.17" y1="8" x2="12" y2="8"></line><line x1="3.95" y1="6.06" x2="8.54" y2="14"></line><line x1="10.88" y1="21.94" x2="15.46" y2="14"></line></svg>
                        SCAN ID VIA CHROME
                    </button>

                    <!-- Feedback Area -->
                    <div id="captureStatus" class="hidden p-4 bg-emerald-50 border border-emerald-200 rounded-2xl animate-in fade-in zoom-in duration-300">
                        <div class="flex items-center gap-3">
                            <div class="w-5 h-5 border-2 border-emerald-300 border-t-emerald-600 rounded-full animate-spin flex-shrink-0"></div>
                            <p id="captureStatusText" class="text-emerald-700 text-[11px] font-bold">Menunggu Anda kembali dari Chrome...</p>
                        </div>
                    </div>

                    <!-- Secondary Actions Grid -->
                    <div class="grid grid-cols-2 gap-3">
                        <a href="/sync" target="_blank" class="py-3.5 px-2 bg-indigo-50 text-indigo-700 rounded-2xl font-black text-[10px] text-center flex items-center justify-center gap-1.5 hover:bg-indigo-100 transition-colors uppercase tracking-tight">
                            <span>✨ Magic Sync</span>
                        </a>
                        <button id="manualIdBtn" class="py-3.5 px-2 bg-slate-50 text-slate-600 rounded-2xl font-black text-[10px] text-center flex items-center justify-center gap-1.5 hover:bg-slate-100 transition-colors uppercase tracking-tight">
                            <span>⚙️ ID Manual</span>
                        </button>
                    </div>

                    <!-- Advanced Troubleshoot Link -->
                    <div class="text-center">
                        <button id="toggleAdvanced" class="text-[10px] font-black text-slate-400 hover:text-indigo-600 uppercase tracking-widest transition-colors">Bantuan Lanjutan ↓</button>
                    </div>

                    <!-- Advanced Section (Hidden) -->
                    <div id="advancedSection" class="hidden space-y-3 pt-2 animate-in slide-in-from-top-2 duration-300">
                        <button id="importJsonBtn" class="w-full py-3 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl font-black text-[10px] uppercase tracking-wide flex items-center justify-center gap-2">
                             🚀 Import Profile JSON (Paling Pasti)
                        </button>
                        <button id="reportLockedBtn" class="w-full py-3 bg-rose-50 text-rose-600 border border-rose-100 rounded-xl font-bold text-[10px] uppercase tracking-wide">
                            Lapor Perangkat Terkunci
                        </button>
                        <button id="browserLoginBtn" class="w-full py-3 bg-amber-50 text-amber-600 border border-amber-100 rounded-xl font-bold text-[10px] uppercase tracking-wide">
                            Gunakan Metode Bookmark
                        </button>
                        <button id="injectSessionBtn" class="w-full py-3 bg-slate-900 text-white rounded-xl font-black text-[10px] uppercase tracking-wide">
                            Inject Session Token
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="mt-8 text-center">
                <p class="text-[10px] font-black text-slate-300 uppercase tracking-[0.3em]">AbsenTech v{APP_VERSION}</p>
            </div>
        </div>
    </div>

    <!-- Modal Update -->
    <div id="updateModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-6 bg-slate-900/90 backdrop-blur-md">
        <div class="w-full max-w-sm bg-white rounded-[40px] p-10 text-center shadow-2xl animate-in zoom-in duration-300">
            <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-3xl flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </div>
            <h2 class="text-2xl font-black text-slate-900 mb-3">Versi Usang</h2>
            <p class="text-slate-500 text-sm font-medium mb-8">Harap update aplikasi ke versi terbaru.</p>
            <a id="updateLink" href="#" class="block w-full py-4 bg-indigo-600 text-white rounded-2xl font-black shadow-xl shadow-indigo-200 hover:bg-indigo-700 transition-all text-center">Download Update</a>
        </div>
    </div>

    <!-- Modal Bypass 2 Langkah (Old Bookmark Method) -->
    <div id="bypassModal" class="hidden fixed inset-0 z-[100] flex items-end justify-center bg-slate-900/80 backdrop-blur-sm p-0">
        <div class="w-full max-w-md bg-white rounded-t-[3rem] shadow-2xl overflow-hidden animate-in slide-in-from-bottom duration-500" style="max-height:85vh;overflow-y:auto;">
            <div class="sticky top-0 bg-white border-b border-slate-50 p-6 flex justify-between items-center z-10">
                <div>
                   <span id="stepLabel" class="text-[9px] font-black uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">Langkah 1</span>
                   <h2 id="stepTitle" class="text-xl font-black text-slate-900 mt-2">Login di Web Resmi</h2>
                </div>
                <button id="closeBypassBtn" class="w-10 h-10 bg-slate-50 rounded-full flex items-center justify-center text-slate-400 hover:text-rose-500 transition-colors">&times;</button>
            </div>

            <div id="step1Content" class="p-8 space-y-4">
                <p id="stepDesc" class="text-sm text-slate-500 mb-4">Browser akan terbuka, lakukan login sampai masuk ke dashboard.</p>
                <div class="space-y-3">
                    <div class="flex items-center gap-4 p-5 bg-indigo-50 rounded-2xl border border-indigo-100">
                        <div class="w-10 h-10 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-black flex-shrink-0 italic">1</div>
                        <p class="text-xs font-bold text-slate-700">Login di Chrome HP Anda</p>
                    </div>
                </div>
                <button id="openBrowserBtn" class="w-full py-5 bg-indigo-600 text-white rounded-2xl font-black shadow-lg shadow-indigo-100 flex items-center justify-center gap-3">
                    Mulai Browser
                </button>
            </div>

            <div id="step2Content" class="p-8 hidden space-y-6">
                <div class="p-5 bg-amber-50 border border-amber-100 rounded-2xl">
                   <p class="text-xs font-bold text-amber-800">Gunakan Bookmark "Sync Absen" yang sudah Anda buat.</p>
                </div>
                
                <button id="recopyBtn" class="w-full py-4 bg-slate-900 text-white rounded-2xl font-black text-sm">Salin Kode Bookmark Baru</button>

                <div class="p-5 bg-indigo-50 rounded-2xl flex items-center gap-3">
                    <div class="w-5 h-5 border-2 border-indigo-300 border-t-indigo-600 rounded-full animate-spin"></div>
                    <p id="waitingText" class="text-xs font-black text-indigo-700 uppercase">Menunggu Sync...</p>
                </div>

                <button id="manualSyncBtn" class="w-full py-4 bg-slate-100 text-slate-600 rounded-2xl font-black text-sm">Cek Manual Sekarang</button>
            </div>
        </div>
    </div>

    <!-- Modal Import JSON (Paling Reliable untuk Mobile) -->
    <div id="jsonModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center bg-slate-900/90 backdrop-blur-md p-6">
        <div class="w-full max-w-sm bg-white rounded-[2.5rem] p-8 shadow-2xl animate-in zoom-in duration-300">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"></polyline><line x1="12" y1="12" x2="12" y2="21"></line><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path><polyline points="16 16 12 12 8 16"></polyline></svg>
            </div>
            <h2 class="text-2xl font-black text-slate-900 mb-2">Capture dari Chrome</h2>
            <p class="text-slate-500 text-[11px] font-medium mb-6 leading-relaxed">
                Metode ini paling berhasil di Android. Pastikan sudah Login di Chrome HP.
            </p>
            
            <button id="goToJsonUrl" class="w-full py-4 bg-emerald-600 text-white rounded-2xl font-black text-xs mb-4 shadow-lg shadow-emerald-100 flex items-center justify-center gap-2 active:scale-95 transition-transform">
                1. BUKA DATA DI CHROME ↗
            </button>

            <div class="space-y-2 mb-4">
                <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">2. Tempel JSON Disini</label>
                <textarea id="jsonInput" placeholder='Tempel (Paste) teks dari Chrome ke sini...' class="w-full h-24 p-4 bg-slate-50 border border-slate-100 rounded-2xl text-[10px] font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
            </div>
            
            <div class="flex gap-2">
                <button id="closeJsonBtn" class="flex-1 py-4 bg-slate-100 text-slate-600 rounded-2xl font-black text-[10px]">BATAL</button>
                <button id="processJsonBtn" class="flex-[2] py-4 bg-indigo-600 text-white rounded-2xl font-black text-[10px] shadow-lg shadow-indigo-100 active:scale-95 transition-transform">3. SIMPAN & LOGIN</button>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { TARGET_BASE_URL, APP_VERSION } from '../utils/constants';
    import { secureFetch } from '../utils/apiClient';
    import { nipService, sessionService, supabaseRequest, adminService } from '../utils/supabase';
    import { storage } from '../utils/storage';
    import { App } from '@capacitor/app';
    import { Browser } from '@capacitor/browser';

    // Handle Deep Links
    App.addListener('appUrlOpen', async (data: any) => {
        const url = new URL(data.url);
        if (url.host === 'sync' || url.pathname.includes('sync')) {
            const token = url.searchParams.get('t');
            const deviceId = url.searchParams.get('d');
            const nip = url.searchParams.get('n');
            const name = url.searchParams.get('name');

            if (token && deviceId) {
                await storage.set('access_token', token);
                await storage.set('token_type', 'bearer');
                await storage.set('fixed_device_id', deviceId);
                if (name) await storage.set('full_name', name);
                
                alert('SINKRONISASI BERHASIL!');
                window.location.href = 'absensi.html';
            }
        }
    });

    // Check for Updates
    (async () => {
        try {
            const settings = await nipService.getSettings();
            if (settings && settings.min_version && APP_VERSION < settings.min_version) {
                const modal = document.getElementById('updateModal');
                const link = document.getElementById('updateLink') as HTMLAnchorElement;
                if (modal && link) {
                    link.href = settings.update_url || '#';
                    modal.classList.remove('hidden');
                }
            }
        } catch (e) {}

        const token = await storage.get('access_token');
        if (token) {
            window.location.href = 'absensi.html';
            return;
        }
        if ((await storage.get('is_admin')) === 'true') {
            window.location.href = 'admin.html';
        }
    })();

    const loginForm = document.getElementById('loginForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn');
    const errorMessage = document.getElementById('errorMessage');
    const loader = submitBtn?.querySelector('.loader');
    const btnText = submitBtn?.querySelector('.btn-text');

    // Advanced Section Toggle
    const toggleAdvanced = document.getElementById('toggleAdvanced');
    const advancedSection = document.getElementById('advancedSection');
    toggleAdvanced?.addEventListener('click', () => {
        const isHidden = advancedSection?.classList.toggle('hidden');
        toggleAdvanced.textContent = isHidden ? 'Bantuan Lanjutan ↓' : 'Tutup Bantuan ↑';
    });

    // Device ID Helper
    const manualIdBtn = document.getElementById('manualIdBtn');
    manualIdBtn?.addEventListener('click', async () => {
        const current = await storage.get('fixed_device_id') || "NONE";
        const res = prompt('ID Perangkat Anda: ' + current + '\n\nMasukkan ID Chrome (DEV-XXXXXX):');
        if (res && res.includes('DEV-')) {
            await storage.set('fixed_device_id', res.trim());
            alert('ID Disimpan: ' + res.trim());
            location.reload();
        }
    });

    // === CHROME CAPTURE (Bookmarklet → Supabase → APK Polling) ===
    const chromeCaptureBtn = document.getElementById('chromeCaptureBtn');
    const captureStatus = document.getElementById('captureStatus');
    const captureStatusText = document.getElementById('captureStatusText');
    let captureNip = '';
    let capturePwd = '';
    let capturePollInterval: any = null;

    chromeCaptureBtn?.addEventListener('click', async () => {
        const formData = new FormData(loginForm);
        captureNip = (formData.get('username') as string || '').trim();
        capturePwd = formData.get('password') as string || '';
        if (!captureNip || !capturePwd) return alert('Isi NIP & Password Anda dulu.');

        // Generate bookmarklet script
        const syncScript = `javascript:void((function(){var d=localStorage.getItem('X-Device-ID');var t=localStorage.getItem('token');var n=localStorage.getItem('full_name')||'';if(!d){alert('GAGAL: Buka DASHBOARD e-Kinerja dulu, baru jalankan script ini lagi.');return;}fetch('https://aiyslkzvbzznfavpllwo.supabase.co/rest/v1/user_sessions',{method:'POST',headers:{'apikey':'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpeXNsa3p2Ynp6bmZhdnBsbHdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Mzg0OTY5OTMsImV4cCI6MjA1NDA3Mjk5M30.kpQS5NZWik_abrK6jOqPDgw_4OHRbQWH','Authorization':'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFpeXNsa3p2Ynp6bmZhdnBsbHdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Mzg0OTY5OTMsImV4cCI6MjA1NDA3Mjk5M30.kpQS5NZWik_abrK6jOqPDgw_4OHRbQWH','Content-Type':'application/json','Prefer':'resolution=merge-duplicates'},body:JSON.stringify({nip:'${captureNip}',device_id:d,token:t||'',full_name:n,updated_at:new Date().toISOString()})}).then(function(){alert('SYNC OK! ID: '+d+'\\nKembali ke AbsenTech.')}).catch(function(e){alert('Error: '+e.message)})})())`;

        try { await navigator.clipboard.writeText(syncScript); } catch {}

        captureStatus?.classList.remove('hidden');
        captureStatusText!.innerHTML = '<b>📋 Dialihkan ke Capture Tool...</b><br>Gunakan halaman khusus untuk menangkap ID dengan mudah.';

        setTimeout(() => {
            window.open('/capture', '_blank');
        }, 1000);

        // Mulai polling Supabase untuk tunggu Device ID
        if (capturePollInterval) clearInterval(capturePollInterval);
        capturePollInterval = setInterval(async () => {
            try {
                const session = await sessionService.getByNip(captureNip);
                if (session && session.device_id && session.device_id !== 'EMPTY' && session.device_id !== 'none') {
                    const age = Date.now() - new Date(session.updated_at).getTime();
                    if (age < 300000) {
                        clearInterval(capturePollInterval);
                        capturePollInterval = null;
                        await storage.set('fixed_device_id', session.device_id);
                        captureStatusText!.innerHTML = '<b>🎯 ' + session.device_id + '</b> — Auto-login...';
                        
                        // Auto-login dengan Device ID yang benar
                        const lr = await rawLogin(captureNip, capturePwd);
                        if (lr.ok && lr.data?.access_token) {
                            await storage.set('access_token', lr.data.access_token);
                            await storage.set('token_type', 'bearer');
                            const pr = await rawProfile(lr.data.access_token);
                            if (pr.ok) await storage.set('full_name', pr.data?.full_name || '');
                            await sessionService.save({ nip: captureNip, device_id: session.device_id, token: lr.data.access_token, full_name: pr?.data?.full_name || '' });
                            alert('🔥 BERHASIL! ID: ' + session.device_id);
                            window.location.href = 'absensi.html';
                        } else {
                            alert('✅ ID tersimpan: ' + session.device_id + '\nKlik MASUK.');
                        }
                    }
                }
            } catch {}
        }, 3000);

        setTimeout(() => { if (capturePollInterval) { clearInterval(capturePollInterval); captureStatusText!.innerHTML = '<b>⏰ Timeout.</b> Klik lagi.'; } }, 600000);
    });

    // Saat kembali dari Chrome, update status
    App.addListener('appStateChange', async (state: any) => {
        if (state.isActive && captureNip && capturePollInterval) {
            captureStatusText!.innerHTML = '<b>🔍 Mengecek Cloud...</b>';
        }
    });

    // Helper: Login & Profile dengan kontrol penuh (tanpa auto-alert)
    const getOrCreateDeviceId = async () => {
        let id = await storage.get('fixed_device_id');
        if (!id || id === '') {
            id = 'DEV-' + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
            await storage.set('fixed_device_id', id);
        }
        return id;
    };

    const rawLogin = async (username: string, password: string) => {
        const { CapacitorHttp } = await import('@capacitor/core');
        const isNative = (window as any).Capacitor?.isNativePlatform();
        const deviceId = await getOrCreateDeviceId();
        if (isNative) {
            const res = await CapacitorHttp.request({
                url: `${TARGET_BASE_URL}/api/v1/auth/login/access-token`, method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json', 'X-Device-ID': deviceId,
                    'User-Agent': 'Mozilla/5.0 (Linux; Android 13) Chrome/120.0.0.0 Mobile Safari/537.36' },
                data: { username, password }, connectTimeout: 15000, readTimeout: 15000
            });
            return { ok: res.status >= 200 && res.status < 300, status: res.status, data: res.data };
        } else {
            const body = new URLSearchParams(); body.append('username', username); body.append('password', password);
            const res = await fetch(`${TARGET_BASE_URL}/api/v1/auth/login/access-token`, { method: 'POST', body, headers: { 'X-Device-ID': deviceId } });
            return { ok: res.ok, status: res.status, data: await res.json() };
        }
    };

    const rawProfile = async (token: string) => {
        const { CapacitorHttp } = await import('@capacitor/core');
        const isNative = (window as any).Capacitor?.isNativePlatform();
        const deviceId = await getOrCreateDeviceId();
        if (isNative) {
            const res = await CapacitorHttp.request({
                url: `${TARGET_BASE_URL}/api/v1/auth/test-token`, method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json', 'X-Device-ID': deviceId,
                    'User-Agent': 'Mozilla/5.0 (Linux; Android 13) Chrome/120.0.0.0 Mobile Safari/537.36' },
                connectTimeout: 15000, readTimeout: 15000
            });
            return { ok: res.status >= 200 && res.status < 300, status: res.status, data: res.data };
        } else {
            const res = await fetch(`${TARGET_BASE_URL}/api/v1/auth/test-token`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'X-Device-ID': deviceId } });
            return { ok: res.ok, status: res.status, data: await res.json() };
        }
    };

    const usernameInput = document.getElementById('username') as HTMLInputElement;

    async function syncFromCloud(nip: string) {
        if (!nip || nip.length < 5) return;
        try {
            const cloud = await sessionService.getByNip(nip);
            if (cloud && cloud.device_id && cloud.device_id !== 'EMPTY') {
                await storage.set('fixed_device_id', cloud.device_id);
                console.log('[CloudSync] Device ID diperbarui otomatis:', cloud.device_id);
                
                if (errorMessage && !errorMessage.classList.contains('hidden')) {
                    errorMessage.textContent = '✅ Device ID Sinkron: ' + cloud.device_id;
                    errorMessage.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-[11px] font-black uppercase tracking-wider text-center';
                }
            }
        } catch (e) {}
    }

    usernameInput?.addEventListener('blur', () => syncFromCloud(usernameInput.value.trim()));

    async function attemptAutoFixDeviceId(nip: string) {
        try {
            const cloud = await sessionService.getByNip(nip);
            if (!cloud || !cloud.token) return false;

            console.log('[AutoFix] Mencoba memperbaiki Device ID menggunakan token lama...');
            const profile = await rawProfile(cloud.token);
            
            if (profile.ok && profile.data) {
                const officialId = profile.data.fixed_device_id || profile.data.device_id;
                if (officialId) {
                    await storage.set('fixed_device_id', officialId);
                    await sessionService.save({
                        nip: nip,
                        device_id: officialId,
                        token: cloud.token,
                        full_name: profile.data.full_name || cloud.full_name
                    });
                    console.log('[AutoFix] Berhasil sinkron ID dari Server:', officialId);
                    return true;
                }
            }
        } catch (e) {
            console.error('[AutoFix] Error:', e);
        }
        return false;
    }

    // Login Form Submit
    loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!submitBtn || !errorMessage || !loader || !btnText) return;

        errorMessage.classList.add('hidden');
        submitBtn.setAttribute('disabled', 'true');
        loader.classList.remove('hidden');
        btnText.classList.add('hidden');

        const formData = new FormData(loginForm);
        const username = (formData.get('username') as string || '').trim();
        const password = formData.get('password') as string;

        if (username === 'admin' && password === 'abcd5678') {
            await storage.set('is_admin', 'true');
            window.location.href = 'admin.html';
            return;
        }

        // Jalankan pengecekan terakhir sebelum submit
        await syncFromCloud(username);

        try {
            // Whitelist Check
            const allowedNips = await nipService.getAll();
            if (!allowedNips.includes(username)) {
                alert('NIP tidak terdaftar di sistem.');
                return;
            }

            // Pre-Login Cloud Lookup - PRIORITASKAN DATA DARI DATABASE (USER REQUEST)
            let finalDeviceId = '';
            try {
                const cloud = await sessionService.getByNip(username);
                // Jika ada di DB dan bukan string 'EMPTY', gunakan itu
                if (cloud && cloud.device_id && cloud.device_id !== 'EMPTY' && cloud.device_id !== 'none' && cloud.device_id !== '') {
                    finalDeviceId = cloud.device_id;
                    await storage.set('fixed_device_id', finalDeviceId);
                    console.log('[Login] Menggunakan Device ID dari Database:', finalDeviceId);
                }
            } catch (e) {
                console.warn('[Login] Gagal cek cloud lookup:', e);
            }

            // Jika di database kosong/gagal, baru ambil dari local storage
            if (!finalDeviceId) {
                finalDeviceId = await storage.get('fixed_device_id') || '';
                if (finalDeviceId) console.log('[Login] Menggunakan Device ID dari Local Storage:', finalDeviceId);
            }

            let token = '';
            let loginOk = false;
            let loginError = '';

            if (finalDeviceId) {
                // Ada Device ID → login pakai secureFetch (dengan ID)
                const response = await secureFetch(`${TARGET_BASE_URL}/api/v1/auth/login/access-token`, {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                if (response.ok && data.access_token) {
                    token = data.access_token;
                    loginOk = true;
                    await storage.set('access_token', token);
                    await storage.set('token_type', data.token_type || 'bearer');
                } else {
                    loginError = data.detail || JSON.stringify(data);
                }
            } else {
                // TANPA Device ID → login pakai rawLogin
                const result = await rawLogin(username, password);
                if (result.ok && result.data?.access_token) {
                    token = result.data.access_token;
                    loginOk = true;
                    await storage.set('access_token', token);
                    await storage.set('token_type', result.data.token_type || 'bearer');
                } else {
                    loginError = result.data?.detail || JSON.stringify(result.data);
                    // Cek apakah error mengandung Device ID
                    const errStr = JSON.stringify(result.data);
                    const matchId = errStr.match(/DEV-[a-z0-9]{4,30}/i);
                    if (matchId) {
                        finalDeviceId = matchId[0];
                        await storage.set('fixed_device_id', finalDeviceId);
                        await sessionService.save({ nip: username, device_id: finalDeviceId, token: '', full_name: '' });
                        errorMessage.textContent = '🎯 Device ID tertangkap: ' + finalDeviceId + ' — Klik MASUK lagi!';
                        errorMessage.classList.remove('hidden');
                        return;
                    }
                }
            }

            if (loginOk && token) {
                // Ambil profil
                const profileResult = await rawProfile(token);
                let name = 'Pegawai';
                if (profileResult.ok) {
                    const p = profileResult.data;
                    name = p.full_name || 'Pegawai';
                    await storage.set('full_name', name);
                    await storage.set('photo_path', p.photo_path || '');
                    
                    // Cari Device ID di profil
                    const pid = p.fixed_device_id || p.device_id || '';
                    if (pid) {
                        finalDeviceId = pid;
                        await storage.set('fixed_device_id', finalDeviceId);
                    }
                }

                // Selalu ambil Device ID terbaru dari storage (mungkin ter-update saat rawProfile/secureFetch)
                const savedDeviceId = await storage.get('fixed_device_id') || finalDeviceId;

                await sessionService.save({
                    nip: username,
                    device_id: savedDeviceId,
                    token: token,
                    full_name: name
                });

                // Check if user is an office admin
                const isOfficeAdmin = await adminService.isAdmin(username);
                if (isOfficeAdmin) {
                    await storage.set('is_admin', 'true');
                    window.location.href = 'admin.html';
                } else {
                    window.location.href = 'absensi.html';
                }
            } else {
                // AUTO-RECOVERY LOGIC
                // Karena server tidak memberitahu ID yang benar di pesan error, 
                // kita gunakan token yang tersimpan di DB untuk fetch ID resmi.
                if (loginError.toLowerCase().includes('perangkat') || loginError.toLowerCase().includes('device') || loginError.toLowerCase().includes('lain') || loginError.includes('403') || loginError.includes('400')) {
                    const success = await attemptAutoFixDeviceId(username);
                    if (success) {
                        errorMessage.textContent = '🚀 DEVICE ID DISINKRONKAN! Klik MASUK Lagi.';
                        errorMessage.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-[11px] font-black uppercase tracking-wider text-center';
                        errorMessage.classList.remove('hidden');
                        return;
                    }
                }

                errorMessage.textContent = loginError || 'Gagal masuk. Cek kembali data Anda.';
                errorMessage.className = 'p-4 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 text-[11px] font-black uppercase tracking-wider text-center';
                errorMessage.classList.remove('hidden');
            }
        } catch {
            errorMessage.textContent = 'Masalah koneksi jaringan.';
            errorMessage.classList.remove('hidden');
        } finally {
            submitBtn.removeAttribute('disabled');
            loader.classList.add('hidden');
            btnText.classList.remove('hidden');
        }
    });

    // Legend items and backup logic
    const reportLockedBtn = document.getElementById('reportLockedBtn');
    reportLockedBtn?.addEventListener('click', async () => {
        const formData = new FormData(loginForm);
        const nip = (formData.get('username') as string || '').trim();
        if (!nip) return alert('Isi NIP dulu.');
        if (confirm('Lapor perangkat terkunci untuk NIP ' + nip + '?')) {
            try {
                await supabaseRequest('reset_requests', { method: 'POST', body: JSON.stringify({ nip, created_at: new Date().toISOString() }) });
                alert('Laporan terkirim!');
            } catch { alert('Gagal mengirim laporan.'); }
        }
    });

    // Inject Session
    const injectSessionBtn = document.getElementById('injectSessionBtn');
    injectSessionBtn?.addEventListener('click', () => {
        const code = prompt('Tempelkan kode sakti dari Chrome:');
        if (!code) return;
        try {
            const d = JSON.parse(atob(code));
            storage.set('access_token', d.t);
            if (d.d) storage.set('fixed_device_id', d.d);
            window.location.href = 'absensi.html';
        } catch { alert('Kode tidak valid.'); }
    });

    // Modal Bookmark Logic (BypassModal)
    const browserLoginBtn = document.getElementById('browserLoginBtn');
    const bypassModal = document.getElementById('bypassModal');
    const closeBypassBtn = document.getElementById('closeBypassBtn');
    const openBrowserBtn = document.getElementById('openBrowserBtn');
    const step1Content = document.getElementById('step1Content');
    const step2Content = document.getElementById('step2Content');
    const skipStepBtn = document.getElementById('manualSyncBtn');

    browserLoginBtn?.addEventListener('click', () => bypassModal?.classList.remove('hidden'));
    closeBypassBtn?.addEventListener('click', () => bypassModal?.classList.add('hidden'));

    openBrowserBtn?.addEventListener('click', async () => {
        const formData = new FormData(loginForm);
        const nip = (formData.get('username') as string || '').trim();
        const script = `javascript:(function(){
            const t = localStorage.getItem('token');
            const d = localStorage.getItem('X-Device-ID');
            const nm = localStorage.getItem('full_name');
            window.location.href = 'absentech://sync?t='+t+'&d='+d+'&n=${nip}&name='+encodeURIComponent(nm);
            fetch('https://aiyslkzvbzznfavpllwo.supabase.co/rest/v1/user_sessions?on_conflict=nip',{
                method:'POST',mode:'no-cors',headers:{'apikey':'sb_publishable_pQS5NZWik_abrK6jOqPDgw_4OHRbQWH','Authorization':'Bearer sb_publishable_pQS5NZWik_abrK6jOqPDgw_4OHRbQWH','Content-Type':'application/json'},
                body:JSON.stringify({nip:'${nip}',device_id:d,token:t,full_name:nm,updated_at:new Date().toISOString()})
            });
            alert('Sync Terkirim!');
        })()`;
        await navigator.clipboard.writeText(script);
        window.open(`${TARGET_BASE_URL}/login`, '_blank');
        step1Content?.classList.add('hidden');
        step2Content?.classList.remove('hidden');
    });

    skipStepBtn?.addEventListener('click', () => window.location.href = 'absensi.html');

    // === METODE JSON CAPTURE ===
    const importJsonBtn = document.getElementById('importJsonBtn');
    const jsonModal = document.getElementById('jsonModal');
    const closeJsonBtn = document.getElementById('closeJsonBtn');
    const goToJsonUrl = document.getElementById('goToJsonUrl');
    const processJsonBtn = document.getElementById('processJsonBtn');
    const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;

    importJsonBtn?.addEventListener('click', () => jsonModal?.classList.remove('hidden'));
    closeJsonBtn?.addEventListener('click', () => {
        jsonModal?.classList.add('hidden');
        jsonInput.value = '';
    });

    goToJsonUrl?.addEventListener('click', async () => {
        const url = `${TARGET_BASE_URL}/api/v1/auth/test-token`;
        try {
            await Browser.open({ url });
        } catch {
            window.open(url, '_blank');
        }
    });

    processJsonBtn?.addEventListener('click', async () => {
        const rawJson = jsonInput.value.trim();
        if (!rawJson) return alert('Silakan tempel teks JSON dari Chrome.');

        try {
            const data = JSON.parse(rawJson);
            const deviceId = data.fixed_device_id || data.device_id;
            const fullName = data.full_name || 'Pegawai';
            const photo = data.photo_path || '';

            if (!deviceId) {
                // Mungkin token expired atau salah halaman
                alert('Device ID tidak ditemukan dalam data tersebut. Pastikan Anda sudah login di Chrome dan menyalin TEKS dari halaman data.');
                return;
            }

            // Ambil NIP dari form jika ada
            const formData = new FormData(loginForm);
            let nip = (formData.get('username') as string || '').trim();
            if (!nip) nip = prompt('Masukkan NIP Anda (untuk sinkronisasi ke Cloud):') || '';
            if (!nip) return;

            // Simpan ke Local
            await storage.set('fixed_device_id', deviceId);
            await storage.set('full_name', fullName);
            await storage.set('photo_path', photo);

            // Kirim ke Supabase (seperti permintaan user)
            try {
                await sessionService.save({
                    nip: nip,
                    device_id: deviceId,
                    token: '', // Kita hanya butuh ID untuk lancarkan login form
                    full_name: fullName,
                });
            } catch (e) {
                console.error('Supabase Sync Error:', e);
            }

            alert('✅ DATA BERHASIL DICAPTURE!\nID: ' + deviceId + '\n\nSilakan masukkan Password dan klik MASUK.');
            jsonModal?.classList.add('hidden');
            jsonInput.value = '';
            
            // Focus ke password biar enak
            document.getElementById('password')?.focus();

        } catch (e) {
            alert('Format tidak valid. Pastikan Anda menyalin SEMUA teks yang muncul di halaman data.');
        }
    });
</script>

