---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Masuk - AbsenTech">
    <div class="min-h-screen flex items-center justify-center p-6 bg-slate-50">
        <div class="w-full max-w-md bg-white rounded-[40px] shadow-2xl shadow-slate-200 border border-slate-100 p-8 sm:p-12 animate-in fade-in slide-in-from-bottom-6 duration-700">
            <div class="text-center mb-10">
                <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-inner ring-1 ring-indigo-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <h1 class="text-2xl font-black text-slate-900 mb-2 tracking-tight">Selamat Datang</h1>
                <p class="text-slate-500 text-sm font-medium">Gunakan akun E-Kinerja Anda</p>
            </div>

            <form id="loginForm" class="space-y-6">
                <div class="space-y-2">
                    <label for="username" class="text-xs font-black text-slate-900 uppercase tracking-widest ml-1">NIP / Username</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <input type="text" id="username" name="username" placeholder="Masukkan NIP" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 text-sm font-bold placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600 focus:bg-white transition-all" required />
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="password" class="text-xs font-black text-slate-900 uppercase tracking-widest ml-1">Password</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                        <input type="password" id="password" name="password" placeholder="Masukkan password" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 text-sm font-bold placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600 focus:bg-white transition-all" required />
                    </div>
                </div>

                <button type="submit" id="submitBtn" class="w-full py-4.5 bg-indigo-600 text-white rounded-2xl font-black text-base shadow-xl shadow-indigo-200 transition-all hover:bg-indigo-700 active:scale-[0.98] flex items-center justify-center gap-3">
                    <span class="btn-text">Masuk Sekarang</span>
                    <div class="loader hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                </button>

                <div id="errorMessage" class="hidden p-4 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 text-[11px] font-black uppercase tracking-wider text-center animate-in fade-in slide-in-from-top-2"></div>
            </form>
            
            <div class="mt-10 text-center">
                <a href="/" class="text-xs font-black text-slate-400 uppercase tracking-widest hover:text-indigo-600 transition-colors">Kembali ke Home</a>
            </div>
        </div>
    </div>

    <!-- Modal Force Update -->
    <div id="updateModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-6 bg-slate-900/90 backdrop-blur-md">
        <div class="w-full max-w-sm bg-white rounded-[40px] p-10 text-center shadow-2xl animate-in zoom-in duration-300">
            <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-3xl flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </div>
            <h2 class="text-2xl font-black text-slate-900 mb-3">Versi Usang</h2>
            <p class="text-slate-500 text-sm font-medium mb-8">Aplikasi Anda perlu diperbarui ke versi terbaru untuk keamanan dan fitur NIP Cloud.</p>
            <a id="updateLink" href="#" class="block w-full py-4.5 bg-indigo-600 text-white rounded-2xl font-black shadow-xl shadow-indigo-200 hover:bg-indigo-700 transition-all">Download Update</a>
        </div>
    </div>
</Layout>

<script>
    import { TARGET_BASE_URL, APP_VERSION } from '../utils/constants';
    import { secureFetch } from '../utils/apiClient';
    import { nipService } from '../utils/supabase';
    import { storage } from '../utils/storage';

    // Force Update Check
    (async () => {
        const settings = await nipService.getSettings();
        if (settings && settings.min_version) {
            const minVersion = settings.min_version;
            const updateUrl = settings.update_url;

            // Simple version comparison (e.g., "1.1.0" vs "1.0.0")
            if (APP_VERSION < minVersion) {
                const modal = document.getElementById('updateModal');
                const link = document.getElementById('updateLink') as HTMLAnchorElement;
                if (modal && link) {
                    link.href = updateUrl || '#';
                    modal.classList.remove('hidden');
                    // Disable login form
                    const form = document.getElementById('loginForm');
                    if (form) form.innerHTML = '<p class="text-center font-bold text-rose-500">UPDATE DIWAJIBKAN</p>';
                }
            }
        }
    })();

    const loginForm = document.getElementById('loginForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn');
    const errorMessage = document.getElementById('errorMessage');
    const loader = submitBtn?.querySelector('.loader');
    const btnText = submitBtn?.querySelector('.btn-text');

    loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!submitBtn || !errorMessage || !loader || !btnText) return;

        errorMessage.classList.add('hidden');
        submitBtn.setAttribute('disabled', 'true');
        loader.classList.remove('hidden');
        btnText.classList.add('hidden');

        const formData = new FormData(loginForm);
        const username = formData.get('username') as string;
        const password = formData.get('password') as string;

        // Admin hardcoded check
        if (username === 'admin' && password === 'abcd5678') {
            await storage.set('is_admin', 'true');
            alert('Login Admin Berhasil!');
            window.location.href = 'admin.html';
            return;
        }

        // Check if NIP is in allowed list from Cloud (Supabase)
        try {
            const allowedNips = await nipService.getAll();
            
            // Simpan juga ke local untuk cache/fallback
            await storage.set('allowed_nips', JSON.stringify(allowedNips));

            if (!allowedNips.includes(username)) {
                alert('NIP Anda tidak terdaftar di Database Cloud. Mengalihkan ke YouTube...');
                window.location.href = 'https://www.youtube.com';
                return;
            }
        } catch (err) {
            console.error('Cloud validation failed, checking local cache...', err);
            const localNipsRaw = await storage.get('allowed_nips');
            const localNips = JSON.parse(localNipsRaw || '[]');
            if (!localNips.includes(username)) {
                alert('Gagal sinkronisasi database dan NIP tidak ada di cache. Mengalihkan ke YouTube...');
                window.location.href = 'https://www.youtube.com';
                return;
            }
        }
        
        try {
            // Menggunakan secureFetch agar support Native bypass CORS di APK
            const response = await secureFetch(`${TARGET_BASE_URL}/api/v1/auth/login/access-token`, {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (response.ok) {
                await storage.set('access_token', data.access_token);
                await storage.set('token_type', data.token_type);
                
                // Get additional user data direct to target
                try {
                    const profileRes = await secureFetch(`${TARGET_BASE_URL}/api/v1/auth/test-token`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `${data.token_type} ${data.access_token}`
                        }
                    });
                    if (profileRes.ok) {
                        const profileData = await profileRes.json();
                        await storage.set('full_name', (profileData.full_name || '').trim());
                        await storage.set('photo_path', profileData.photo_path || '');
                    }
                } catch (e) {
                    console.error('Failed to fetch profile:', e);
                }

                alert('Login Berhasil! Mengalihkan ke Dashboard...');
                window.location.href = 'absensi.html';

            } else {
                alert('Login Gagal: ' + (data.detail || 'Periksa NIP Anda'));
                errorMessage.textContent = data.detail || 'Login gagal. Periksa kembali NIP.';
                errorMessage.classList.remove('hidden');
            }
        } catch (error) {
            alert('Kesalahan Koneksi: ' + JSON.stringify(error));
            errorMessage.textContent = 'Kesalahan koneksi (Pastikan internet HP aktif).';
            errorMessage.classList.remove('hidden');
        } finally {
            submitBtn.removeAttribute('disabled');
            loader.classList.add('hidden');
            btnText.classList.remove('hidden');
        }
    });

