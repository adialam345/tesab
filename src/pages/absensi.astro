---
import Layout from '../layouts/Layout.astro';
import LocationStatus from '../components/LocationStatus.astro';
import CameraPreview from '../components/CameraPreview.astro';
import AttendanceInfo from '../components/AttendanceInfo.astro';
---

<Layout title="Dashboard Absensi - AbsenTech">
    <div class="min-h-screen bg-slate-50 pb-12">
        <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="w-11 h-11 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shadow-sm overflow-hidden" id="userPhotoContainer">
                        <svg id="userPhotoPlaceholder" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <img id="userPhoto" src="" class="w-full h-full object-cover hidden" alt="Profile" />
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Akses Pegawai</span>
                        <span class="font-extrabold text-slate-900 text-sm" id="userName">Verifikasi Akun...</span>
                    </div>
                </div>
                <button id="logoutBtn" class="flex items-center gap-2 bg-rose-50 text-rose-600 border border-rose-100 py-2.5 px-4 rounded-xl text-xs font-bold transition-all hover:bg-rose-100 active:scale-95">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span class="hidden sm:inline">Keluar</span>
                </button>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
            <div class="animate-fade-in">
                <LocationStatus />
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-6 lg:gap-8 items-start">
                <div class="animate-slide-in-left">
                    <CameraPreview />
                </div>
                <div class="animate-slide-in-right">
                    <AttendanceInfo />
                </div>
            </div>
        </main>
    </div>
    <script is:inline src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
</Layout>

<script>
    import { initCamera, loadFaceModels, extractFaceEmbedding, generateDummyEmbedding } from '../utils/camera';
    import { getRandomOffset, fetchLocation, submitCheckIn, submitCheckOut } from '../utils/location';
    import { updateLivenessProgress } from '../utils/liveness';

    const USER_AGENT = 'Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Mobile Safari/537.36';

    const state = {
        targetLocation: null as any,
        capturedPhoto: null as string | null,
        faceEmbedding: null as number[] | null,
        isCheckingLiveness: false,
        isCheckingOut: false,
        token: localStorage.getItem('access_token')
    };

    const ui = {
        video: document.getElementById('video') as HTMLVideoElement,
        canvas: document.getElementById('canvas') as HTMLCanvasElement,
        photo: document.getElementById('photo') as HTMLImageElement,
        captureBtn: document.getElementById('captureBtn'),
        galleryBtn: document.getElementById('galleryBtn'),
        retakeBtn: document.getElementById('retakeBtn'),
        fileInput: document.getElementById('fileInput') as HTMLInputElement,
        checkInBtn: document.getElementById('checkInBtn') as HTMLButtonElement,
        checkInStatus: document.getElementById('checkInStatus'),
        livenessUI: document.getElementById('livenessUI'),
        livenessInstruction: document.getElementById('livenessInstruction'),
        livenessProgress: document.getElementById('livenessProgress'),
        faceMatch: document.getElementById('faceMatch'),
        faceMatchProgress: document.getElementById('faceMatchProgress')
    };

    if (!state.token) window.location.href = '/login';

    async function processPhoto(dataUrl: string) {
        state.capturedPhoto = dataUrl;
        ui.photo.src = dataUrl;
        ui.video.classList.add('hidden');
        ui.photo.classList.remove('hidden');
        ui.captureBtn?.classList.add('hidden');
        ui.galleryBtn?.classList.add('hidden');
        ui.retakeBtn?.classList.remove('hidden');

        state.faceEmbedding = await extractFaceEmbedding(ui.photo) || generateDummyEmbedding();
        if (state.targetLocation) ui.checkInBtn.disabled = false;

        if (ui.checkInStatus) {
            ui.checkInStatus.innerHTML = '<strong>✅ Foto Berhasil Diambil</strong>';
            ui.checkInStatus.className = 'status-message success-text mt-4';
            ui.checkInStatus.classList.remove('hidden');
        }
    }

    async function runCaptureSequence() {
        if (!state.isCheckingLiveness) return;
        
        if (ui.livenessInstruction) {
            ui.livenessInstruction.innerHTML = `
                <div class="flex flex-col items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-2 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    <span class="text-[13px] font-black tracking-widest text-white uppercase">HARAP SENYUM</span>
                </div>
            `;
        }
        if (ui.livenessProgress) ui.livenessProgress.style.width = `100%`;

        // Pulse the scanning line or something to indicate capture
        setTimeout(async () => {
            state.isCheckingLiveness = false;
            ui.canvas.width = ui.video.videoWidth;
            ui.canvas.height = ui.video.videoHeight;
            ui.canvas.getContext('2d')?.drawImage(ui.video, 0, 0);
            await processPhoto(ui.canvas.toDataURL('image/jpeg', 0.8));
            ui.livenessUI?.classList.add('hidden');
        }, 200);
    }

    ui.captureBtn?.addEventListener('click', () => {
        ui.livenessUI?.classList.remove('hidden');
        state.isCheckingLiveness = true;
        runCaptureSequence();
    });

    ui.galleryBtn?.addEventListener('click', () => ui.fileInput?.click());
    ui.fileInput?.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => processPhoto(e.target?.result as string);
            reader.readAsDataURL(file);
        }
    });

    ui.retakeBtn?.addEventListener('click', () => {
        ui.video.classList.remove('hidden');
        ui.photo.classList.add('hidden');
        ui.captureBtn?.classList.remove('hidden');
        ui.galleryBtn?.classList.remove('hidden');
        ui.retakeBtn.classList.add('hidden');
        state.capturedPhoto = null;
        state.faceEmbedding = null;
        isAutoCapturing = false;
        ui.checkInBtn.disabled = true;
        if (ui.checkInStatus) ui.checkInStatus.classList.add('hidden');
    });

    ui.checkInBtn?.addEventListener('click', async () => {
        if (!state.targetLocation || !state.capturedPhoto || !ui.checkInStatus || !state.token) return;
        ui.checkInBtn.disabled = true;
        ui.checkInBtn.textContent = 'Mengirim...';
        ui.checkInStatus.classList.remove('hidden');
        ui.checkInStatus.className = 'status-message info-text';

        const offset = getRandomOffset(20, state.targetLocation.latitude);
        const payload = {
            lat: state.targetLocation.latitude + offset.deltaLat,
            lng: state.targetLocation.longitude + offset.deltaLng,
            device_id: USER_AGENT,
            photo_base64: state.capturedPhoto,
            face_embedding: state.faceEmbedding,
            is_mock_location: false,
            location_accuracy: 8.5 + Math.random() * 1.5
        };

        console.log('--- Attendance Payload ---');
        console.log('Full Payload:', payload);
        console.log('Face Embedding:', payload.face_embedding);
        console.log('Type:', state.isCheckingOut ? 'Check-Out' : 'Check-In');
        console.log('------------------------');

        const result = state.isCheckingOut 
            ? await submitCheckOut(state.token, payload)
            : await submitCheckIn(state.token, payload);
        
        ui.checkInStatus.innerHTML = result.ok 
            ? `<strong>✅ ${state.isCheckingOut ? 'Check-Out' : 'Absensi'} Berhasil Disimpan</strong>` 
            : `<strong>❌ Gagal Mengirim (${result.status})</strong>`;
        ui.checkInStatus.className = `status-message mt-4 ${result.ok ? 'success-text' : 'error-text'}`;
        
        // Show Raw JSON Response
        const jsonContainer = document.getElementById('jsonResponseContainer');
        const jsonPre = document.getElementById('jsonResponse');
        if (jsonContainer && jsonPre) {
            jsonPre.textContent = JSON.stringify(result.data || { error: 'No data returned' }, null, 2);
            jsonContainer.classList.remove('hidden');
        }

        if (!result.ok) {
            ui.checkInBtn.disabled = false;
            ui.checkInBtn.textContent = 'Coba Lagi';
        } else {
            ui.checkInBtn.textContent = 'Selesai';
        }
    });

    document.getElementById('copyJsonBtn')?.addEventListener('click', () => {
        const jsonPre = document.getElementById('jsonResponse');
        if (jsonPre) {
            navigator.clipboard.writeText(jsonPre.textContent || '');
            const btn = document.getElementById('copyJsonBtn');
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = 'COPIED!';
                setTimeout(() => btn.textContent = originalText, 2000);
            }
        }
    });

    ui.retakeBtn?.addEventListener('click', () => {
        ui.video.classList.remove('hidden');
        ui.photo.classList.add('hidden');
        ui.captureBtn?.classList.remove('hidden');
        ui.galleryBtn?.classList.remove('hidden');
        ui.retakeBtn.classList.add('hidden');
        state.capturedPhoto = null;
        state.faceEmbedding = null;
        isAutoCapturing = false;
        ui.checkInBtn.disabled = true;
        if (ui.checkInStatus) ui.checkInStatus.classList.add('hidden');
        const jsonContainer = document.getElementById('jsonResponseContainer');
        if (jsonContainer) jsonContainer.classList.add('hidden');
    });

    let isAutoCapturing = false;
    let isDetecting = false;
    const HOLD_DURATION = 500;
    let smoothedScore = 0;

    async function updateFaceDetection() {
        if (ui.video.paused || ui.video.ended || state.capturedPhoto !== null || isAutoCapturing || isDetecting) {
            if (state.capturedPhoto !== null) {
                ui.livenessUI?.classList.add('hidden');
            }
            setTimeout(updateFaceDetection, 100);
            return;
        }
        
        isDetecting = true;
        try {
            // @ts-ignore
            const detection = await faceapi.detectSingleFace(ui.video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks();

            const faceStatusDot = document.getElementById('faceStatusDot');

            if (ui.faceMatch) {
                if (detection) {
                    const rawScore = detection.detection.score * 100;
                    // Smoother factor: 0.15 for even more stability
                    smoothedScore = smoothedScore + (rawScore - smoothedScore) * 0.15;
                    const displayScore = Math.round(smoothedScore);

                    ui.faceMatch.textContent = `Harap Senyum (${displayScore}%)`;
                    ui.faceMatch.className = 'text-indigo-600 font-extrabold';
                    
                    if (faceStatusDot) {
                        faceStatusDot.className = 'w-1.5 h-1.5 rounded-full dot-success animate-pulse-slow';
                    }

                    // Auto capture only when visual score reaches 70%
                    if (displayScore >= 70 && !isAutoCapturing) {
                        isAutoCapturing = true;
                        ui.livenessUI?.classList.remove('hidden');
                        if (ui.livenessInstruction) {
                            ui.livenessInstruction.innerHTML = `
                                <div class="flex flex-col items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-2 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                                    <span class="text-[13px] font-black tracking-widest text-white uppercase">HARAP SENYUM</span>
                                </div>
                            `;
                        }
                        state.isCheckingLiveness = true;
                        runCaptureSequence();
                    }
                } else {
                    // Gradually fade out score when no face is detected
                    smoothedScore = smoothedScore * 0.7;
                    if (smoothedScore < 1) smoothedScore = 0;
                    
                    ui.livenessUI?.classList.add('hidden');
                    ui.faceMatch.textContent = 'Mencari Wajah...';
                    ui.faceMatch.className = 'text-slate-400 font-bold';
                    if (faceStatusDot) {
                        faceStatusDot.className = 'w-1.5 h-1.5 rounded-full dot-searching animate-pulse-slow';
                    }
                }
            }
            if (ui.faceMatchProgress) {
                ui.faceMatchProgress.style.width = detection ? `${Math.round(smoothedScore)}%` : '15%';
            }
        } catch (e) {
            console.error('Face detection error:', e);
        } finally {
            isDetecting = false;
            setTimeout(updateFaceDetection, 100);
        }
    }

    document.getElementById('logoutBtn')?.addEventListener('click', () => {
        localStorage.clear();
        window.location.href = '/login';
    });

    (async () => {
        initCamera(ui.video);
        loadFaceModels();
        updateFaceDetection();
        const loc = await fetchLocation(state.token || '');
        if (loc) {
            state.targetLocation = loc;
            const targetNameEl = document.getElementById('targetName');
            const targetAddressEl = document.getElementById('targetAddress');
            const coordsEl = document.getElementById('coords');
            const radiusEl = document.getElementById('radius');
            const statusBadge = document.getElementById('statusBadge');
            
            if (targetNameEl) targetNameEl.textContent = loc.name;
            if (targetAddressEl) targetAddressEl.textContent = loc.address;
            if (coordsEl) coordsEl.textContent = `${loc.latitude.toFixed(6)}, ${loc.longitude.toFixed(6)}`;
            if (radiusEl) radiusEl.textContent = `${loc.radius_meters}m`;
            if (statusBadge) {
                statusBadge.textContent = 'Sesuai';
                statusBadge.classList.add('success');
            }
            
            const userNameEl = document.getElementById('userName');
            if (userNameEl) {
                const fullName = localStorage.getItem('full_name');
                userNameEl.textContent = fullName ? fullName.trim() : 'Pegawai Kinerja';
            }

            const photoPath = localStorage.getItem('photo_path');
            if (photoPath) {
                const userPhoto = document.getElementById('userPhoto') as HTMLImageElement;
                const userPhotoPlaceholder = document.getElementById('userPhotoPlaceholder');
                if (userPhoto && userPhotoPlaceholder) {
                    userPhoto.src = `https://absensi-kinerja.labuhanbatuselatankab.go.id${photoPath}`;
                    userPhoto.classList.remove('hidden');
                    userPhotoPlaceholder.classList.add('hidden');
                }
            }

            // Fetch today's attendance
            try {
                const attendRes = await fetch('/api/attendance-today', {
                    headers: { 'Authorization': `Bearer ${state.token}` }
                });
                if (attendRes.ok) {
                    const attendData = await attendRes.json();
                    if (attendData && attendData.id) {
                        const baseUrl = 'https://absensi-kinerja.labuhanbatuselatankab.go.id';
                        
                        // Update Clock In
                        if (attendData.clock_in) {
                            const inTimeEl = document.getElementById('clockInTime');
                            const inPhotoEl = document.getElementById('clockInPhoto') as HTMLImageElement;
                            const inPhotoPlaceholder = document.getElementById('clockInPhotoPlaceholder');
                            
                            if (inTimeEl) inTimeEl.textContent = new Date(attendData.clock_in).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                            if (attendData.in_photo && inPhotoEl && inPhotoPlaceholder) {
                                inPhotoEl.src = `${baseUrl}${attendData.in_photo}`;
                                inPhotoEl.classList.remove('hidden');
                                inPhotoPlaceholder.classList.add('hidden');
                            }
                        }

                        // Update Clock Out
                        if (attendData.clock_out) {
                            const outTimeEl = document.getElementById('clockOutTime');
                            const outPhotoEl = document.getElementById('clockOutPhoto') as HTMLImageElement;
                            const outPhotoPlaceholder = document.getElementById('clockOutPhotoPlaceholder');
                            
                            if (outTimeEl) outTimeEl.textContent = new Date(attendData.clock_out).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                            if (attendData.out_photo && outPhotoEl && outPhotoPlaceholder) {
                                outPhotoEl.src = `${baseUrl}${attendData.out_photo}`;
                                outPhotoEl.classList.remove('hidden');
                                outPhotoPlaceholder.classList.add('hidden');
                            }
                        }
                        // Decide if next action is check-out
                        if (attendData.clock_in && !attendData.clock_out) {
                            state.isCheckingOut = true;
                            ui.checkInBtn.textContent = 'Kirim Check-Out';
                            ui.checkInBtn.classList.replace('bg-indigo-600', 'bg-rose-600');
                        } else if (attendData.clock_in && attendData.clock_out) {
                            ui.checkInBtn.textContent = 'Sudah Absen Hari Ini';
                            ui.checkInBtn.disabled = true;
                        }
                    }
                }
            } catch (e) {
                console.error('Failed to fetch today attendance:', e);
            }
        }
    })();
</script>
