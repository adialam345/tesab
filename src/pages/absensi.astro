---
import Layout from '../layouts/Layout.astro';
import LocationStatus from '../components/LocationStatus.astro';
import CameraPreview from '../components/CameraPreview.astro';
import AttendanceInfo from '../components/AttendanceInfo.astro';
import UserHeader from '../components/UserHeader.astro';
---

<Layout title="Dashboard Absensi - AbsenTech">
    <div class="min-h-screen bg-slate-50 pb-12">
        <UserHeader />

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
            <div class="animate-fade-in">
                <LocationStatus />
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-6 lg:gap-8 items-start">
                <div class="animate-slide-in-left">
                    <CameraPreview />
                </div>
                <div class="animate-slide-in-right">
                    <AttendanceInfo />
                </div>
            </div>
        </main>
    </div>
    <script is:inline src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
</Layout>

<script>
    import { initCamera, loadFaceModels } from '../utils/camera';
    import { getRandomOffset, fetchLocation } from '../utils/location';
    import { TARGET_BASE_URL, LAPANGAN_BUPATI_LOCATION } from '../utils/constants';
    import { secureFetch } from '../utils/apiClient';
    import { updateButtonStates, handleAttendanceSubmission } from '../utils/attendanceLogic';
    import { processPhoto, runCaptureSequence } from '../utils/photoProcessor';
    import { updateFaceDetection, setAutoCapturing } from '../utils/faceDetectionLoop';
    import { storage } from '../utils/storage';
    // OTA DISABLED - Build APK baru untuk setiap update

    const state = {
        officeLocation: null as any,
        targetLocation: null as any,
        selectedLocationType: 'office' as 'office' | 'bupati',
        simulatedLocation: null as { lat: number, lng: number } | null,
        capturedPhoto: null as string | null,
        faceEmbedding: null as number[] | null,
        isCheckingLiveness: false,
        hasCheckedIn: false,
        hasCheckedOut: false,
        hasBreakOut: false,
        hasBreakIn: false,
        isBreakIn: false,
        isBreakOut: false,
        token: null as string | null,
        deviceId: ''
    };

    const ui = {
        video: document.getElementById('video') as HTMLVideoElement,
        canvas: document.getElementById('canvas') as HTMLCanvasElement,
        photo: document.getElementById('photo') as HTMLImageElement,
        captureBtn: document.getElementById('captureBtn'),
        galleryBtn: document.getElementById('galleryBtn'),
        retakeBtn: document.getElementById('retakeBtn'),
        fileInput: document.getElementById('fileInput') as HTMLInputElement,
        checkInBtn: document.getElementById('checkInBtn') as HTMLButtonElement,
        checkInBtnText: document.getElementById('checkInBtnText'),
        checkInStatus: document.getElementById('checkInStatus'),
        livenessUI: document.getElementById('livenessUI'),
        livenessInstruction: document.getElementById('livenessInstruction'),
        livenessProgress: document.getElementById('livenessProgress'),
        faceMatch: document.getElementById('faceMatch'),
        faceMatchProgress: document.getElementById('faceMatchProgress'),
        breakInBtn: document.getElementById('breakInBtn') as HTMLButtonElement,
        breakInBtnText: document.getElementById('breakInBtnText'),
        breakOutBtn: document.getElementById('breakOutBtn') as HTMLButtonElement,
        breakOutBtnText: document.getElementById('breakOutBtnText')
    };

    // if (!state.token) window.location.href = '/login'; // Moved inside async init

    // Event Listeners
    ui.captureBtn?.addEventListener('click', () => {
        ui.livenessUI?.classList.remove('hidden');
        state.isCheckingLiveness = true;
        runCaptureSequence(ui, state);
    });

    ui.galleryBtn?.addEventListener('click', () => ui.fileInput?.click());
    
    ui.fileInput?.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    const videoWidth = img.width;
                    const videoHeight = img.height;
                    const size = Math.min(videoWidth, videoHeight);
                    const x = (videoWidth - size) / 2;
                    const y = (videoHeight - size) / 2;
                    ui.canvas.width = 229;
                    ui.canvas.height = 229;
                    const ctx = ui.canvas.getContext('2d');
                    if (ctx) {
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'high';
                        ctx.drawImage(img, x, y, size, size, 0, 0, 229, 229);
                    }
                    processPhoto(ui.canvas.toDataURL('image/jpeg', 0.8), ui, state);
                };
                img.src = e.target?.result as string;
            };
            reader.readAsDataURL(file);
        }
    });

    ui.retakeBtn?.addEventListener('click', () => {
        ui.video.classList.remove('hidden');
        ui.photo.classList.add('hidden');
        ui.captureBtn?.classList.remove('hidden');
        ui.galleryBtn?.classList.remove('hidden');
        ui.retakeBtn.classList.add('hidden');
        state.capturedPhoto = null;
        state.faceEmbedding = null;
        setAutoCapturing(false);
        updateButtonStates(ui, state);
        if (ui.checkInStatus) ui.checkInStatus.classList.add('hidden');
        document.getElementById('jsonDebugContainer')?.classList.add('hidden');
    });

    ui.checkInBtn?.addEventListener('click', () => handleAttendanceSubmission(state.hasCheckedIn ? 'check-out' : 'check-in', ui, state, state.deviceId));
    ui.breakInBtn?.addEventListener('click', () => handleAttendanceSubmission('break-in', ui, state, state.deviceId));
    ui.breakOutBtn?.addEventListener('click', () => handleAttendanceSubmission('break-out', ui, state, state.deviceId));

    document.getElementById('copyRequestBtn')?.addEventListener('click', () => {
        const jsonPre = document.getElementById('jsonRequest');
        if (jsonPre) {
            navigator.clipboard.writeText(jsonPre.textContent || '');
            const btn = document.getElementById('copyRequestBtn');
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = 'COPIED!';
                setTimeout(() => btn.textContent = originalText, 2000);
            }
        }
    });

    document.getElementById('copyJsonBtn')?.addEventListener('click', () => {
        const jsonPre = document.getElementById('jsonResponse');
        if (jsonPre) {
            navigator.clipboard.writeText(jsonPre.textContent || '');
            const btn = document.getElementById('copyJsonBtn');
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = 'COPIED!';
                setTimeout(() => btn.textContent = originalText, 2000);
            }
        }
    });

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        await storage.clear();
        window.location.href = 'login.html';
    });

    // Initialization
    (async () => {
        console.log('Starting Dashboard Initialization...');
        
        // 0. Load Token First
        state.token = await storage.get('access_token');
        if (!state.token) {
            window.location.href = 'login.html';
            return;
        }

        // 1. Setup User Profile & Device ID
        const fixedDeviceId = await storage.get('fixed_device_id');
        state.deviceId = fixedDeviceId || "";
        console.log('Using Device ID:', state.deviceId || "EMPTY");

        const userNameEl = document.getElementById('userName');
        if (userNameEl) {
            const fullName = await storage.get('full_name');
            userNameEl.textContent = fullName ? fullName.trim() : 'Pegawai Kinerja';
        }

        const photoPath = await storage.get('photo_path');
        if (photoPath) {
            const userPhoto = document.getElementById('userPhoto') as HTMLImageElement;
            const userPhotoPlaceholder = document.getElementById('userPhotoPlaceholder');
            if (userPhoto && userPhotoPlaceholder) {
                // Jika path sudah ada http, jangan tambah base url
                const finalUrl = photoPath.startsWith('http') ? photoPath : `${TARGET_BASE_URL}${photoPath}`;
                userPhoto.src = finalUrl;
                userPhoto.classList.remove('hidden');
                userPhotoPlaceholder.classList.add('hidden');
                
                // Fallback jika gambar error/mati
                userPhoto.onerror = () => {
                   userPhoto.classList.add('hidden');
                   userPhotoPlaceholder.classList.remove('hidden');
                };
            }
        }

        // 2. Fetch Attendance Info
        try {
            const trimmedToken = state.token?.trim() || '';
            const attendRes = await secureFetch(`${TARGET_BASE_URL}/api/v1/attendance/today`, {
                headers: { 
                    'Authorization': `Bearer ${trimmedToken}`,
                    'Accept': 'application/json',
                    'Referer': `${TARGET_BASE_URL}/absensi`
                }
            });
            
            if (attendRes.ok) {
                const attendData = await attendRes.json();
                if (attendData) {
                    if (attendData.clock_in) {
                        state.hasCheckedIn = true;
                        const inTimeEl = document.getElementById('clockInTime');
                        const inPhotoEl = document.getElementById('clockInPhoto') as HTMLImageElement;
                        const inPhotoPlaceholder = document.getElementById('clockInPhotoPlaceholder');
                        if (inTimeEl) inTimeEl.textContent = new Date(attendData.clock_in).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                        if (attendData.in_photo && inPhotoEl && inPhotoPlaceholder) {
                            inPhotoEl.src = `${TARGET_BASE_URL}${attendData.in_photo}`;
                            inPhotoEl.classList.remove('hidden');
                            inPhotoPlaceholder.classList.add('hidden');
                        }
                    }
                    if (attendData.clock_out) {
                        state.hasCheckedOut = true;
                        const outTimeEl = document.getElementById('clockOutTime');
                        const outPhotoEl = document.getElementById('clockOutPhoto') as HTMLImageElement;
                        const outPhotoPlaceholder = document.getElementById('clockOutPhotoPlaceholder');
                        if (outTimeEl) outTimeEl.textContent = new Date(attendData.clock_out).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                        if (attendData.out_photo && outPhotoEl && outPhotoPlaceholder) {
                            outPhotoEl.src = `${TARGET_BASE_URL}${attendData.out_photo}`;
                            outPhotoEl.classList.remove('hidden');
                            outPhotoPlaceholder.classList.add('hidden');
                        }
                    }
                    if (attendData.break_in) {
                        state.hasBreakIn = true;
                        const breakInEl = document.getElementById('breakInTime');
                        if (breakInEl) breakInEl.textContent = new Date(attendData.break_in).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                    }
                    if (attendData.break_out) {
                        state.hasBreakOut = true;
                        const breakOutEl = document.getElementById('breakOutTime');
                        if (breakOutEl) breakOutEl.textContent = new Date(attendData.break_out).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                    }
                    updateButtonStates(ui, state);
                }
            }
        } catch (e: any) {
            console.error(`Error fetching today attendance: ${e.message}`);
        }

        // 3. Setup Camera & Face detection
        initCamera(ui.video);
        loadFaceModels();
        updateFaceDetection(ui, state);

        // Helper to apply target location & update UI
        function setAttendanceTarget(targetLoc: any, type: 'office' | 'bupati') {
            state.targetLocation = targetLoc;
            state.selectedLocationType = type;
            const offset = getRandomOffset(Math.min(10, targetLoc.radius_meters || 10), targetLoc.latitude);
            state.simulatedLocation = { lat: targetLoc.latitude + offset.deltaLat, lng: targetLoc.longitude + offset.deltaLng };
            const estimatedDistance = Math.sqrt(Math.pow(offset.deltaLat * 111320, 2) + Math.pow(offset.deltaLng * 111320 * Math.cos(targetLoc.latitude * Math.PI / 180), 2)).toFixed(1);

            const targetNameEl = document.getElementById('targetName');
            const targetAddressEl = document.getElementById('targetAddress');
            const coordsEl = document.getElementById('coords');
            const coordsLabelEl = document.getElementById('coordsLabel');
            const userCoordsEl = document.getElementById('userCoords');
            const userDistanceEl = document.getElementById('userDistance');
            const radiusEl = document.getElementById('radius');
            const statusBadge = document.getElementById('statusBadge');
            const activeLocTag = document.getElementById('activeLocTag');

            if (targetNameEl) targetNameEl.textContent = targetLoc.name;
            if (targetAddressEl) targetAddressEl.textContent = targetLoc.address;
            if (coordsEl) coordsEl.textContent = `${targetLoc.latitude.toFixed(6)}, ${targetLoc.longitude.toFixed(6)}`;
            if (coordsLabelEl) coordsLabelEl.textContent = type === 'bupati' ? 'Koordinat Lap. Bupati' : 'Koordinat Target';
            if (userCoordsEl) userCoordsEl.textContent = `${state.simulatedLocation.lat.toFixed(6)}, ${state.simulatedLocation.lng.toFixed(6)}`;
            if (userDistanceEl) userDistanceEl.textContent = `± ${estimatedDistance} meter`;
            if (radiusEl) radiusEl.textContent = `${targetLoc.radius_meters}m`;
            if (statusBadge) {
                statusBadge.textContent = 'Sesuai';
                statusBadge.className = 'px-4 py-2 rounded-full text-[10px] font-extrabold shrink-0 tracking-wider uppercase transition-colors status-badge success';
            }

            if (activeLocTag) {
                activeLocTag.classList.remove('hidden');
                if (type === 'bupati') {
                    activeLocTag.textContent = 'Lap. Bupati';
                    activeLocTag.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-800';
                } else {
                    activeLocTag.textContent = 'Kantor';
                    activeLocTag.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-700';
                }
            }

            // Update button styles in Monday selector if present
            const officeBtn = document.getElementById('locOptionOffice');
            const bupatiBtn = document.getElementById('locOptionBupati');
            const officeCheck = document.getElementById('officeCheckIcon');
            const bupatiCheck = document.getElementById('bupatiCheckIcon');

            if (officeBtn && bupatiBtn) {
                if (type === 'office') {
                    officeBtn.className = 'location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-indigo-600 bg-indigo-50/50 text-left transition-all cursor-pointer shadow-sm';
                    bupatiBtn.className = 'location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all cursor-pointer hover:border-slate-300';
                    officeCheck?.classList.remove('hidden');
                    bupatiCheck?.classList.add('hidden');
                } else {
                    bupatiBtn.className = 'location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-indigo-600 bg-indigo-50/50 text-left transition-all cursor-pointer shadow-sm';
                    officeBtn.className = 'location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all cursor-pointer hover:border-slate-300';
                    bupatiCheck?.classList.remove('hidden');
                    officeCheck?.classList.add('hidden');
                }
            }

            try {
                localStorage.setItem('selected_attendance_loc_type', type);
            } catch (e) {}

            updateButtonStates(ui, state);
        }

        // 4. Fetch Location
        const loc = await fetchLocation(state.token || '');
        if (loc) {
            state.officeLocation = loc;

            // Check if today is Monday (getDay() === 1) or forced by URL/localStorage
            const urlParams = new URLSearchParams(window.location.search);
            const isMonday = new Date().getDay() === 1 || urlParams.get('senin') === 'true' || localStorage.getItem('force_senin') === 'true';

            const mondaySection = document.getElementById('mondayLocationSection');
            const locOfficeName = document.getElementById('locOfficeName');
            const locOfficeAddress = document.getElementById('locOfficeAddress');
            const officeBtn = document.getElementById('locOptionOffice');
            const bupatiBtn = document.getElementById('locOptionBupati');

            if (locOfficeName) locOfficeName.textContent = loc.name || 'Kantor OPD';
            if (locOfficeAddress) locOfficeAddress.textContent = loc.address ? `${loc.address} (${loc.radius_meters}m)` : `Radius ${loc.radius_meters}m`;

            if (isMonday) {
                if (mondaySection) mondaySection.classList.remove('hidden');

                officeBtn?.addEventListener('click', () => {
                    setAttendanceTarget(state.officeLocation, 'office');
                });

                bupatiBtn?.addEventListener('click', () => {
                    setAttendanceTarget(LAPANGAN_BUPATI_LOCATION, 'bupati');
                });

                // Check stored preference or default to office
                const savedType = localStorage.getItem('selected_attendance_loc_type');
                if (savedType === 'bupati') {
                    setAttendanceTarget(LAPANGAN_BUPATI_LOCATION, 'bupati');
                } else {
                    setAttendanceTarget(loc, 'office');
                }
            } else {
                setAttendanceTarget(loc, 'office');
            }
        }
    })();
</script>