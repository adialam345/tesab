---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Panel - AbsenTech">
    <div class="min-h-screen bg-slate-50 pb-12">
        <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="w-11 h-11 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Administrator</span>
                        <span class="font-extrabold text-slate-900 text-sm">Panel Kontrol NIP</span>
                    </div>
                </div>
                <button id="logoutAdminBtn" class="flex items-center gap-2 bg-rose-50 text-rose-600 border border-rose-100 py-2.5 px-4 rounded-xl text-xs font-bold transition-all hover:bg-rose-100 active:scale-95">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Keluar Admin</span>
                </button>
            </div>
        </header>

        <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 space-y-8">
            <!-- Add NIP Section -->
            <div class="bg-white rounded-[32px] p-8 shadow-xl shadow-slate-200/50 border border-slate-100">
                <h2 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-3">
                    <span class="w-8 h-8 bg-indigo-600 text-white rounded-lg flex items-center justify-center text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </span>
                    Tambah NIP Baru
                </h2>
                
                <form id="addNipForm" class="flex flex-col sm:flex-row gap-4">
                    <div class="flex-1 relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-600 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <input type="text" id="newNip" placeholder="Masukkan NIP Pegawai" class="w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-slate-900 font-bold placeholder:text-slate-400 focus:outline-none focus:ring-4 focus:ring-indigo-600/10 focus:border-indigo-600 focus:bg-white transition-all" required />
                    </div>
                    <button type="submit" class="sm:px-8 py-4 bg-indigo-600 text-white rounded-2xl font-black shadow-lg shadow-indigo-200 hover:bg-indigo-700 active:scale-95 transition-all">
                        Simpan NIP
                    </button>
                </form>
            </div>

            <!-- List NIP Section -->
            <div class="bg-white rounded-[32px] overflow-hidden shadow-xl shadow-slate-200/50 border border-slate-100">
                <div class="p-8 border-b border-slate-50">
                    <h2 class="text-xl font-black text-slate-900 flex items-center gap-3">
                        <span class="w-8 h-8 bg-slate-100 text-slate-600 rounded-lg flex items-center justify-center text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        </span>
                        Daftar NIP Terdaftar
                    </h2>
                </div>
                
                <div class="max-h-[500px] overflow-y-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-slate-50/50">
                                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">NIP Pegawai</th>
                                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="nipTableBody" class="divide-y divide-slate-50">
                            <!-- NIP rows will be injected here -->
                        </tbody>
                    </table>
                    
                    <div id="emptyState" class="hidden py-20 text-center">
                        <div class="w-16 h-16 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        </div>
                        <p class="text-slate-400 font-bold">Belum ada NIP yang didaftarkan</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</Layout>

<script>
    // Security check
    if (localStorage.getItem('is_admin') !== 'true') {
        window.location.href = 'login.html';
    }

    const nipTableBody = document.getElementById('nipTableBody');
    const emptyState = document.getElementById('emptyState');
    const addNipForm = document.getElementById('addNipForm') as HTMLFormElement;
    const newNipInput = document.getElementById('newNip') as HTMLInputElement;
    const logoutAdminBtn = document.getElementById('logoutAdminBtn');

    function getAllowedNips(): string[] {
        const nips = localStorage.getItem('allowed_nips');
        return nips ? JSON.parse(nips) : [];
    }

    function saveAllowedNips(nips: string[]) {
        localStorage.setItem('allowed_nips', JSON.stringify(nips));
        renderNips();
    }

    function renderNips() {
        if (!nipTableBody || !emptyState) return;

        const nips = getAllowedNips();
        
        if (nips.length === 0) {
            nipTableBody.innerHTML = '';
            emptyState.classList.remove('hidden');
            return;
        }

        emptyState.classList.add('hidden');
        nipTableBody.innerHTML = nips.map(nip => `
            <tr class="hover:bg-slate-50/50 transition-colors group">
                <td class="px-8 py-5">
                    <span class="font-extrabold text-slate-700 tracking-tight">${nip}</span>
                </td>
                <td class="px-8 py-5 text-right">
                    <button onclick="window.removeNip('${nip}')" class="p-2.5 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                </td>
            </tr>
        `).reverse().join('');
    }

    // @ts-ignore
    window.removeNip = (nip: string) => {
        if (confirm(`Hapus NIP ${nip} dari daftar akses?`)) {
            const nips = getAllowedNips();
            const filtered = nips.filter(n => n !== nip);
            saveAllowedNips(filtered);
        }
    };

    addNipForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const nip = newNipInput.value.trim();
        if (!nip) return;

        const nips = getAllowedNips();
        if (nips.includes(nip)) {
            alert('NIP sudah ada dalam daftar!');
            return;
        }

        nips.push(nip);
        saveAllowedNips(nips);
        newNipInput.value = '';
        alert('NIP berhasil ditambahkan!');
    });

    logoutAdminBtn?.addEventListener('click', () => {
        localStorage.removeItem('is_admin');
        window.location.href = 'login.html';
    });

    // Initial render
    renderNips();
</script>
