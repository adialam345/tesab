---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Panel - AbsenTech">
    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        :root {
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.4);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top left, #f8fafc 0%, #f1f5f9 100%);
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 28px;
        }

        .gradient-text {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-premium {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.15);
        }

        .btn-premium:active {
            transform: translateY(0);
        }

        .input-premium {
            transition: all 0.2s ease;
        }

        .input-premium:focus {
            transform: scale(1.01);
        }

        .nav-blur {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>

    <div class="min-h-screen pb-20">
        <!-- Navigation -->
        <header class="nav-blur sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center text-center">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-blue-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200 ring-4 ring-indigo-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div class="flex flex-col text-left">
                        <span class="text-[10px] font-black text-indigo-500 uppercase tracking-[0.2em]">Management System</span>
                        <h1 class="font-extrabold text-slate-800 text-lg leading-tight">Admin Console</h1>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <button id="logoutAdminBtn" class="group flex items-center gap-2 bg-white text-rose-500 border border-rose-100 py-3 px-6 rounded-2xl text-xs font-bold transition-all hover:bg-rose-500 hover:text-white hover:shadow-lg hover:shadow-rose-100 active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:rotate-12 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Logout Session</span>
                    </button>
                    <div class="h-10 w-px bg-slate-200 mx-2 hidden sm:block"></div>
                    <div class="hidden sm:flex items-center gap-3 pl-2">
                         <div class="text-right">
                             <p class="text-[10px] font-black text-slate-400 uppercase">Status</p>
                             <p class="text-xs font-bold text-emerald-500 flex items-center gap-1.5 justify-end">
                                 <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                 Cloud Online
                             </p>
                         </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-6 pt-12">
            <!-- Grid Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Left Column: Controls -->
                <div class="lg:col-span-12 xl:col-span-4 space-y-8">
                    <!-- Quick Add NIP -->
                    <section class="glass-card p-8 shadow-2xl shadow-slate-200/40 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full -mr-16 -mt-16 transition-transform group-hover:scale-110"></div>
                        
                        <div class="relative">
                            <h2 class="text-lg font-extrabold text-slate-800 mb-6 flex items-center gap-3">
                                <span class="w-10 h-10 bg-indigo-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-indigo-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </span>
                                Master NIP
                            </h2>
                            
                            <form id="addNipForm" class="space-y-4">
                                <div class="relative">
                                    <input type="text" id="newNip" placeholder="Masukkan NIP Baru..." class="input-premium w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-900 font-bold placeholder:text-slate-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm" required />
                                </div>
                                <button type="submit" class="btn-premium w-full py-4 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-2xl font-black text-sm uppercase tracking-wider shadow-xl shadow-indigo-100">
                                    Daftarkan Pegawai
                                </button>
                            </form>
                        </div>
                    </section>

                    <!-- Office Admin Add -->
                    <section class="glass-card p-8 shadow-2xl shadow-slate-200/40 relative overflow-hidden group">
                         <div class="absolute top-0 right-0 w-32 h-32 bg-violet-500/5 rounded-full -mr-16 -mt-16"></div>
                         <div class="relative">
                            <h2 class="text-lg font-extrabold text-slate-800 mb-6 flex items-center gap-3">
                                <span class="w-10 h-10 bg-violet-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-violet-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                                </span>
                                Admin Otoritas
                            </h2>
                            <form id="addAdminForm" class="space-y-4">
                                <input type="text" id="newAdminNip" placeholder="NIP untuk Admin..." class="input-premium w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-900 font-bold placeholder:text-slate-400 focus:outline-none focus:ring-4 focus:ring-violet-500/10 focus:border-violet-500 focus:bg-white transition-all shadow-sm" required />
                                <button type="submit" class="btn-premium w-full py-4 bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-2xl font-black text-sm uppercase tracking-wider shadow-xl shadow-violet-100">
                                    Berikan Akses
                                </button>
                            </form>
                         </div>
                    </section>
                </div>

                <!-- Right Column: Lists & Tables -->
                <div class="lg:col-span-12 xl:col-span-8 space-y-8">
                    <!-- Reset Device Control Card -->
                    <section class="glass-card p-8 shadow-2xl shadow-slate-200/40">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
                            <div>
                                <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-3">
                                    <span class="w-10 h-10 bg-rose-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-rose-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
                                    </span>
                                    Synchronize & Reset Device
                                </h2>
                                <p class="text-slate-400 text-xs mt-2 ml-13 font-medium tracking-tight">Perbaikan Device ID yang terkunci di Server Pusat</p>
                            </div>
                            
                            <button id="loadAdminTokenBtn" class="btn-premium flex items-center gap-3 bg-amber-50 text-amber-600 border border-amber-200 py-3.5 px-6 rounded-2xl text-xs font-black shadow-sm group">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-active:rotate-180 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                <span>SYNC ADMIN TOKENS</span>
                            </button>
                        </div>

                        <div class="bg-slate-50 p-6 rounded-[24px] border border-slate-100 mb-8">
                             <div class="flex flex-col sm:flex-row gap-4">
                                <div class="flex-1 space-y-2">
                                    <label class="text-[10px] uppercase font-black text-slate-400 ml-1">Admin Context (Active Token)</label>
                                    <input type="password" id="adminToken" placeholder="Ready to Fetch..." 
                                           class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl text-slate-900 font-bold placeholder:text-slate-300 focus:outline-none shadow-sm" readonly />
                                </div>
                                <div class="flex-1 space-y-2">
                                    <label class="text-[10px] uppercase font-black text-slate-400 ml-1">Target NIP Target</label>
                                    <div class="flex gap-3">
                                        <input type="text" id="resetNip" placeholder="Contoh: 1984..." 
                                               class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl text-slate-900 font-bold placeholder:text-slate-300 focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all shadow-sm" />
                                        <button id="resetDeviceBtn" class="btn-premium px-8 bg-rose-600 text-white rounded-2xl font-black text-sm uppercase shadow-lg shadow-rose-200 flex items-center gap-2">
                                            <span>RESET</span>
                                            <div class="loader hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                        </button>
                                    </div>
                                </div>
                             </div>
                        </div>

                        <!-- Reset Requests List -->
                        <div class="space-y-4">
                            <div class="flex items-center justify-between px-1">
                                <h3 class="text-[11px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                                    Reset Requests Log
                                </h3>
                                <div class="h-px flex-1 bg-slate-100 mx-4"></div>
                            </div>
                            <div id="requestsList" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <!-- Requests will be loaded here -->
                                <div class="col-span-2 text-center py-6 text-slate-300 text-xs italic bg-slate-50/50 rounded-2xl border border-dashed">Menunggu data masuk...</div>
                            </div>
                        </div>
                    </section>

                    <!-- Registered NIPS & Admins (Tabs) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Table NIP -->
                        <section class="glass-card shadow-2xl shadow-slate-200/40 flex flex-col h-[600px]">
                            <div class="p-6 border-b border-slate-100 shrink-0">
                                <h2 class="text-sm font-black text-slate-800 uppercase tracking-widest flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                    Registered NIP List
                                </h2>
                            </div>
                            <div class="overflow-y-auto flex-1 custom-scrollbar">
                                <table class="w-full text-left">
                                    <tbody id="nipTableBody" class="divide-y divide-slate-50">
                                        <!-- Content -->
                                    </tbody>
                                </table>
                                <div id="emptyState" class="hidden py-12 text-center">
                                    <div class="w-16 h-16 bg-slate-50 text-slate-200 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                    </div>
                                    <p class="text-slate-300 font-bold text-xs uppercase">No Records Found</p>
                                </div>
                            </div>
                        </section>

                        <!-- Office Admins -->
                        <section class="glass-card shadow-2xl shadow-slate-200/40 flex flex-col h-[600px]">
                             <div class="p-6 border-b border-slate-100 shrink-0">
                                <h2 class="text-sm font-black text-slate-800 uppercase tracking-widest flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                    Active Office Admins
                                </h2>
                            </div>
                            <div id="adminList" class="p-6 space-y-3 overflow-y-auto custom-scrollbar">
                                <!-- Admin list -->
                            </div>
                        </section>
                    </div>

                </div>
            </div>
        </main>
    </div>
</Layout>

<script>
    import { nipService, supabaseRequest, sessionService, adminService } from '../utils/supabase';
    import { storage } from '../utils/storage';
    import { TARGET_BASE_URL } from '../utils/constants';
    import { secureFetch } from '../utils/apiClient';

    // Security check
    (async () => {
        if (await storage.get('is_admin') !== 'true') {
            window.location.href = 'login.html';
        }
        
        // Load admin token if already saved in session (optional)
        const savedToken = sessionStorage.getItem('official_admin_token');
        if (savedToken) {
            (document.getElementById('adminToken') as HTMLInputElement).value = savedToken;
        }

        renderRequests();
    })();

    async function renderRequests() {
        const list = document.getElementById('requestsList');
        if (!list) return;

        try {
            const data = await supabaseRequest('reset_requests?select=*&order=created_at.desc');
            if (!data || data.length === 0) {
                list.innerHTML = '<div class="col-span-2 text-center py-6 text-slate-300 text-xs italic bg-slate-50/50 rounded-2xl border border-dashed">Tidak ada permintaan menunggu</div>';
                return;
            }

            list.innerHTML = data.map((req: any) => `
                <div class="flex items-center justify-between p-4 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all group animate-in fade-in slide-in-from-bottom-2 duration-300">
                    <div class="flex flex-col gap-0.5">
                        <p class="text-[13px] font-black text-slate-700">${req.nip}</p>
                        <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tight">${new Date(req.created_at).toLocaleString('id-ID', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' })}</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="window.useRequestNip('${req.nip}')" class="px-4 py-2 bg-indigo-50 text-indigo-600 rounded-xl text-[10px] font-black hover:bg-indigo-600 hover:text-white transition-all shadow-sm">LOAD</button>
                        <button onclick="window.deleteRequest('${req.id}')" class="p-2 text-slate-300 hover:text-rose-500 hover:bg-rose-50 rounded-xl transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
            `).join('');
        } catch(e) {
            list.innerHTML = '<div class="col-span-2 text-center py-6 text-rose-400 text-xs italic">Gagal memuat permintaan</div>';
        }
    }

    // @ts-ignore
    window.useRequestNip = (nip: string) => {
        (document.getElementById('resetNip') as HTMLInputElement).value = nip;
        const btn = document.getElementById('resetNip');
        btn?.focus();
    };

    // @ts-ignore
    window.deleteRequest = async (id: string) => {
        try {
            await supabaseRequest(`reset_requests?id=eq.${id}`, { method: 'DELETE' });
            renderRequests();
        } catch(e) {}
    };

    const resetDeviceBtn = document.getElementById('resetDeviceBtn');
    const resetNipInput = document.getElementById('resetNip') as HTMLInputElement;
    const adminTokenInput = document.getElementById('adminToken') as HTMLInputElement;
    const loadAdminTokenBtn = document.getElementById('loadAdminTokenBtn');

    loadAdminTokenBtn?.addEventListener('click', async () => {
        const adminNips = ['198410172017042006', '198701172010012020'];
        loadAdminTokenBtn.setAttribute('disabled', 'true');
        const originalText = loadAdminTokenBtn.innerHTML;
        loadAdminTokenBtn.innerHTML = '<div class="w-4 h-4 border-2 border-amber-600/30 border-t-amber-600 rounded-full animate-spin"></div>';
        
        try {
            const tokens = [];
            for (const nip of adminNips) {
                const session = await sessionService.getByNip(nip);
                if (session && session.token) {
                    tokens.push(session.token);
                }
            }

            if (tokens.length > 0) {
                adminTokenInput.value = `ACTIVE: ${tokens.length} TOKENS LOADED`;
                sessionStorage.setItem('official_admin_tokens', JSON.stringify(tokens));
            } else {
                alert(`Tidak ada token aktif ditemukan untuk Admin di Cloud.`);
                adminTokenInput.value = "FAILED TO FETCH TOKENS";
            }
        } catch (e: any) {
            alert('Gagal mengambil token: ' + e.message);
        } finally {
            loadAdminTokenBtn.removeAttribute('disabled');
            loadAdminTokenBtn.innerHTML = originalText;
        }
    });

    async function performReset(targetNip: string) {
        const manualToken = adminTokenInput.value.trim();
        let tokensToTry: string[] = [];

        if (manualToken && !manualToken.startsWith('ACTIVE:')) {
            tokensToTry.push(manualToken);
        }

        const saved = sessionStorage.getItem('official_admin_tokens');
        if (saved) {
            try {
                const cloudTokens = JSON.parse(saved);
                tokensToTry = [...tokensToTry, ...cloudTokens];
            } catch(e) {}
        }

        tokensToTry = [...new Set(tokensToTry)].filter(t => t);

        if (tokensToTry.length === 0) {
            alert('Token Admin kosong! Harap klik SYNC ADMIN TOKENS.');
            return;
        }

        const loader = resetDeviceBtn?.querySelector('.loader');
        resetDeviceBtn?.setAttribute('disabled', 'true');
        loader?.classList.remove('hidden');

        let lastError = 'User tidak ditemukan di semua token admin.';

        try {
            for (const token of tokensToTry) {
                const searchRes = await secureFetch(`${TARGET_BASE_URL}/api/v1/users/?skip=0&limit=20&search=${targetNip}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!searchRes.ok) continue; 

                const searchData = await searchRes.json();
                if (!Array.isArray(searchData) || searchData.length === 0) continue; 

                const targetUser = searchData[0];
                const userId = targetUser.id;

                const resetRes = await secureFetch(`${TARGET_BASE_URL}/api/v1/users/${userId}/reset-device`, {
                    method: 'PUT',
                    headers: { 
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    }
                });

                if (resetRes.ok) {
                    alert(`BERHASIL! Perangkat untuk ${targetUser.full_name || targetNip} telah di-reset.`);
                    resetNipInput.value = '';
                    return;
                } else {
                    const error = await resetRes.json();
                    lastError = `Gagal Reset: ${error.detail || 'Error tak dikenal'}`;
                }
            }
            alert(`GAGAL: ${lastError}`);
        } catch (e: any) {
            alert('Kesalahan Koneksi: ' + e.message);
        } finally {
            resetDeviceBtn?.removeAttribute('disabled');
            loader?.classList.add('hidden');
        }
    }

    resetDeviceBtn?.addEventListener('click', async () => {
        const targetNip = resetNipInput.value.trim();
        if (!targetNip) return;
        await performReset(targetNip);
    });

    const nipTableBody = document.getElementById('nipTableBody');
    const emptyState = document.getElementById('emptyState');
    const addNipForm = document.getElementById('addNipForm') as HTMLFormElement;
    const newNipInput = document.getElementById('newNip') as HTMLInputElement;
    const logoutAdminBtn = document.getElementById('logoutAdminBtn');

    async function renderNips() {
        if (!nipTableBody || !emptyState) return;

        try {
            const nips = await nipService.getAll();
            if (nips.length === 0) {
                nipTableBody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            nipTableBody.innerHTML = nips.map(nip => `
                <tr class="hover:bg-slate-50/80 transition-all group animate-in slide-in-from-right-2 duration-200">
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 rounded-full bg-indigo-400 group-hover:scale-150 transition-transform"></div>
                            <span class="font-extrabold text-slate-700 tracking-tight text-sm">${nip}</span>
                        </div>
                    </td>
                    <td class="px-6 py-5 text-right flex justify-end gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
                        <button onclick="window.syncNipFromOfficial('${nip}')" class="p-2.5 text-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all" title="Sinkron ID">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 12c0-4.4 3.6-8 8-8 3.3 0 6.2 2 7.4 5M22 12c0 4.4-3.6 8-8 8-3.3 0-6.2-2-7.4-5"/></svg>
                        </button>
                        <button onclick="window.removeNip('${nip}')" class="p-2.5 text-rose-300 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-all" title="Hapus">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
                        </button>
                    </td>
                </tr>
            `).reverse().join('');
        } catch (e) {
            console.error(e);
        }
    }

    // @ts-ignore
    window.syncNipFromOfficial = async (nip: string) => {
        const saved = sessionStorage.getItem('official_admin_tokens');
        if (!saved) return alert('Harap klik SYNC ADMIN TOKENS terlebih dahulu!');
        
        const tokens = JSON.parse(saved);
        if (tokens.length === 0) return alert('Tidak ada token admin tersedia.');

        for (const token of tokens) {
            try {
                const searchRes = await secureFetch(`${TARGET_BASE_URL}/api/v1/users/?search=${nip}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!searchRes.ok) continue;

                const searchData = await searchRes.json();
                if (searchData.length > 0) {
                    const user = searchData[0];
                    const officialId = user.fixed_device_id || user.device_id;
                    if (officialId) {
                        await sessionService.save({
                            nip: nip,
                            device_id: officialId,
                            token: '', 
                            full_name: user.full_name
                        });
                        alert(`BERHASIL! ID sinkron: ${officialId}`);
                        return;
                    }
                }
            } catch (e) {}
        }
        alert('GAGAL: Data tidak ditemukan.');
    };

    // @ts-ignore
    window.removeNip = async (nip: string) => {
        if (confirm(`Hapus NIP ${nip}?`)) {
            try {
                await nipService.remove(nip);
                await renderNips();
            } catch (e) {}
        }
    };

    addNipForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nip = newNipInput.value.trim();
        if (!nip) return;

        try {
            await nipService.add(nip);
            newNipInput.value = '';
            await renderNips();
            alert('NIP Berhasil didaftarkan!');
        } catch (e) {
            alert('Gagal menyimpan NIP.');
        }
    });

    logoutAdminBtn?.addEventListener('click', async () => {
        await storage.remove('is_admin');
        window.location.href = 'login.html';
    });

    // Office Admin Management
    async function renderAdmins() {
        const list = document.getElementById('adminList');
        if (!list) return;

        try {
            const admins = await adminService.getAll();
            if (admins.length === 0) {
                list.innerHTML = '<div class="text-center py-6 text-slate-300 text-xs italic bg-slate-50/50 rounded-2xl border border-dashed">No office admins set</div>';
                return;
            }

            list.innerHTML = admins.map(nip => `
                <div class="flex items-center justify-between p-4 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-indigo-100/50 hover:border-indigo-100 transition-all group animate-in fade-in slide-in-from-left-2 duration-300">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-violet-50 text-violet-500 rounded-xl flex items-center justify-center group-hover:bg-violet-500 group-hover:text-white transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <span class="font-black text-slate-700 tracking-tight">${nip}</span>
                    </div>
                    <button onclick="window.removeAdmin('${nip}')" class="p-2.5 text-slate-300 hover:text-rose-500 hover:bg-rose-50 rounded-xl transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                </div>
            `).join('');
        } catch (e) {
            list.innerHTML = '<div class="text-center py-4 text-rose-400 text-xs italic">Error loading admins</div>';
        }
    }

    // @ts-ignore
    window.removeAdmin = async (nip: string) => {
        if (confirm(`Cabut akses Admin ${nip}?`)) {
            try {
                await adminService.remove(nip);
                await renderAdmins();
            } catch (e) {}
        }
    };

    const addAdminForm = document.getElementById('addAdminForm');
    const newAdminNipInput = document.getElementById('newAdminNip') as HTMLInputElement;

    addAdminForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nip = newAdminNipInput.value.trim();
        if (!nip) return;

        try {
            await adminService.add(nip);
            newAdminNipInput.value = '';
            await renderAdmins();
            alert('Admin Kantor ditambahkan!');
        } catch (e) {
            alert('Gagal menambah admin.');
        }
    });

    // Initial render
    renderNips();
    renderAdmins();
</script>

