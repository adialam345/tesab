---
---
<div id="jsonDebugContainer" class="hidden mt-4 space-y-4">
    <!-- Request Body -->
    <div class="space-y-2">
        <div class="flex justify-between items-center px-1">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Request Body</span>
            <button id="copyRequestBtn" class="text-[9px] font-black text-indigo-600 uppercase tracking-widest hover:text-indigo-700 transition-colors">Copy Request</button>
        </div>
        <pre id="jsonRequest" class="p-4 bg-slate-100 rounded-2xl text-[10px] text-slate-600 font-mono overflow-x-auto border border-slate-200 shadow-inner scrollbar-hide max-h-48"></pre>
    </div>

    <!-- Server Response -->
    <div class="space-y-2">
        <div class="flex justify-between items-center px-1">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Server Response</span>
            <button id="copyJsonBtn" class="text-[9px] font-black text-indigo-600 uppercase tracking-widest hover:text-indigo-700 transition-colors">Copy Response</button>
        </div>
        <pre id="jsonResponse" class="p-4 bg-slate-900 rounded-2xl text-[10px] text-emerald-400 font-mono overflow-x-auto border border-slate-800 shadow-inner scrollbar-hide max-h-48"></pre>
    </div>
</div>
