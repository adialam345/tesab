---
interface Props {
    targetLocation?: any;
}

const { targetLocation } = Astro.props;
---

<div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm transition-all hover:shadow-md" id="locationStatus">
    <div class="flex items-center gap-5">
        <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
                <h3 class="text-base font-extrabold text-slate-900 mb-0.5">Lokasi Absensi</h3>
                <span id="activeLocTag" class="hidden px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-700">Kantor</span>
            </div>
            <p id="targetName" class="text-sm font-semibold text-slate-600 truncate">{targetLocation ? targetLocation.name : 'Memuat data lokasi...'}</p>
            <p id="targetAddress" class="text-xs text-slate-400 truncate mt-0.5">{targetLocation?.address || ''}</p>
        </div>
        <div class="px-4 py-2 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-500 shrink-0 tracking-wider uppercase transition-colors" id="statusBadge">
            Checking
        </div>
    </div>

    <!-- Pilihan Absen Khusus Hari Senin (Lapangan Bupati vs Kantor) -->
    <div id="mondayLocationSection" class="hidden mt-5 pt-4 border-t border-slate-100">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-800">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Khusus Hari Senin
                </span>
                <span class="text-xs font-bold text-slate-500">Pilih Lokasi Absensi:</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Pilihan 1: Kantor Default -->
            <button type="button" id="locOptionOffice" class="location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-indigo-600 bg-indigo-50/50 text-left transition-all cursor-pointer">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-slate-900 truncate" id="locOfficeName">Kantor OPD</span>
                        <span id="officeCheckIcon" class="w-4 h-4 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-bold">✓</span>
                    </div>
                    <p class="text-[11px] text-slate-500 truncate mt-0.5" id="locOfficeAddress">Sesuai unit kerja</p>
                </div>
            </button>

            <!-- Pilihan 2: Lapangan Bupati -->
            <button type="button" id="locOptionBupati" class="location-choice-btn relative flex items-center gap-3 p-3.5 rounded-2xl border-2 border-slate-200 bg-white text-left transition-all cursor-pointer hover:border-slate-300">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-slate-900 truncate">Lapangan Bupati</span>
                        <span id="bupatiCheckIcon" class="w-4 h-4 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px] font-bold hidden">✓</span>
                    </div>
                    <p class="text-[11px] text-slate-500 truncate mt-0.5">Apel Gabungan &bull; Radius 100m</p>
                </div>
            </button>
        </div>
    </div>
</div>

<style>
    /* Global classes for internal JS manipulation */
    :global(.status-badge.success) {
        background-color: #ecfdf5 !important;
        color: #059669 !important;
        border: 1px solid #a7f3d0 !important;
    }

    :global(.status-badge.error) {
        background-color: #fef2f2 !important;
        color: #dc2626 !important;
        border: 1px solid #fecaca !important;
    }
</style>
