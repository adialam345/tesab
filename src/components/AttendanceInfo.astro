<div class="bg-white p-6 rounded-[32px] border border-slate-200 shadow-sm flex flex-col gap-6">
    <div class="flex items-center gap-3">
        <div class="text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div class="font-extrabold text-lg text-slate-900">Informasi Absensi</div>
    </div>

    <div class="space-y-5">
        <div class="flex justify-between items-center pb-4 border-bottom border-slate-50">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Koordinat Kantor</span>
            <span class="text-sm font-black text-slate-800" id="coords">...</span>
        </div>
        <div class="flex justify-between items-center pb-4 border-bottom border-slate-50">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Lokasi Anda (Simulasi)</span>
            <span class="text-sm font-black text-indigo-600" id="userCoords">Mencari...</span>
        </div>
        <div class="flex justify-between items-center pb-4 border-bottom border-slate-50">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Estimasi Jarak</span>
            <span class="text-sm font-black text-emerald-600" id="userDistance">...</span>
        </div>
        <div class="flex justify-between items-center pb-4 border-bottom border-slate-50">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Radius Aman</span>
            <span class="text-sm font-black text-slate-800" id="radius">...</span>
        </div>
        <div class="flex justify-between items-center pb-4 border-b border-slate-50">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Status Lokasi</span>
            <div class="flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full text-xs font-black ring-1 ring-emerald-100" id="locationMatch">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>Terhubung</span>
            </div>
        </div>

        <!-- Today's Attendance Status -->
        <div class="space-y-4 pt-4 border-t border-slate-100">
            <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4">Aktivitas Hari Ini</h3>
            
            <div class="grid grid-cols-2 gap-3">
                <!-- Clock In -->
                <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100/50">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Masuk</span>
                    </div>
                    <div id="clockInTime" class="text-sm font-black text-slate-800 mb-2">--:--</div>
                    <div class="w-full aspect-square rounded-xl bg-slate-200 overflow-hidden relative group">
                        <img id="clockInPhoto" src="" class="w-full h-full object-cover hidden" alt="Masuk" />
                        <div id="clockInPhotoPlaceholder" class="absolute inset-0 flex items-center justify-center text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                        </div>
                    </div>
                </div>

                <!-- Clock Out -->
                <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100/50">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-2 h-2 rounded-full bg-rose-500"></div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Pulang</span>
                    </div>
                    <div id="clockOutTime" class="text-sm font-black text-slate-800 mb-2">--:--</div>
                    <div class="w-full aspect-square rounded-xl bg-slate-200 overflow-hidden relative group">
                        <img id="clockOutPhoto" src="" class="w-full h-full object-cover hidden" alt="Pulang" />
                        <div id="clockOutPhotoPlaceholder" class="absolute inset-0 flex items-center justify-center text-slate-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                        </div>
                    </div>
                </div>

                <!-- Break In -->
                <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100/50">
                    <div class="flex items-center gap-2 mb-1">
                        <div class="w-2 h-2 rounded-full bg-amber-500"></div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Istirahat In</span>
                    </div>
                    <div id="breakInTime" class="text-sm font-black text-slate-800">--:--</div>
                </div>

                <!-- Break Out -->
                <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100/50">
                    <div class="flex items-center gap-2 mb-1">
                        <div class="w-2 h-2 rounded-full bg-cyan-600"></div>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Istirahat Out</span>
                    </div>
                    <div id="breakOutTime" class="text-sm font-black text-slate-800">--:--</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3">
        <button id="breakInBtn" class="flex items-center justify-center gap-2 py-3 bg-amber-500 text-white rounded-2xl font-black text-xs shadow-lg shadow-amber-100 transition-all hover:bg-amber-600 active:scale-95 disabled:opacity-50 disabled:pointer-events-none" disabled>
            Istirahat (In)
        </button>
        <button id="breakOutBtn" class="flex items-center justify-center gap-2 py-3 bg-cyan-600 text-white rounded-2xl font-black text-xs shadow-lg shadow-cyan-100 transition-all hover:bg-cyan-700 active:scale-95 disabled:opacity-50 disabled:pointer-events-none" disabled>
            Istirahat (Out)
        </button>
    </div>

    <div class="mt-4">
        <button id="checkInBtn" class="w-full flex items-center justify-center gap-3 py-4 bg-indigo-600 text-white rounded-2xl font-black text-base shadow-xl shadow-indigo-200 transition-all hover:bg-indigo-700 active:scale-95 disabled:opacity-50 disabled:pointer-events-none disabled:shadow-none" disabled>
            Kirim Absensi
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
    </div>
    
    <div id="checkInStatus" class="p-4 rounded-xl text-xs font-medium text-center animate-in fade-in slide-in-from-bottom-2 hidden"></div>

    <!-- JSON Debug Containers -->
    <div id="jsonDebugContainer" class="hidden mt-4 space-y-4">
        <!-- Request Body -->
        <div class="space-y-2">
            <div class="flex justify-between items-center px-1">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Request Body</span>
                <button id="copyRequestBtn" class="text-[9px] font-black text-indigo-600 uppercase tracking-widest hover:text-indigo-700 transition-colors">Copy Request</button>
            </div>
            <pre id="jsonRequest" class="p-4 bg-slate-100 rounded-2xl text-[10px] text-slate-600 font-mono overflow-x-auto border border-slate-200 shadow-inner scrollbar-hide max-h-48"></pre>
        </div>

        <!-- Server Response -->
        <div class="space-y-2">
            <div class="flex justify-between items-center px-1">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Server Response</span>
                <button id="copyJsonBtn" class="text-[9px] font-black text-indigo-600 uppercase tracking-widest hover:text-indigo-700 transition-colors">Copy Response</button>
            </div>
            <pre id="jsonResponse" class="p-4 bg-slate-900 rounded-2xl text-[10px] text-emerald-400 font-mono overflow-x-auto border border-slate-800 shadow-inner scrollbar-hide max-h-48"></pre>
        </div>
    </div>
</div>

<style>
    /* Utility colors mapping from JS */
    :global(.status-message.info-text) {
        background-color: #eef2ff !important;
        color: #4f46e5 !important;
        border: 1px solid #c7d2fe !important;
    }

    :global(.status-message.success-text) {
        background-color: #ecfdf5 !important;
        color: #059669 !important;
        border: 1px solid #a7f3d0 !important;
    }

    :global(.status-message.error-text) {
        background-color: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1px solid #fee2e2 !important;
    }

</style>
